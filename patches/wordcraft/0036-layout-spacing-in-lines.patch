+/// Spacing in lines (`w:beforeLines`/`w:afterLines`, hundredths of a line) is read and written
+/// back; it was dropped on save, and with it the space between WPS paragraphs that have no
+/// spacing in twips.
+#[test]
+fn spacing_in_lines_is_read_and_kept() {
+    let body =
+        r#"<w:p><w:pPr><w:spacing w:beforeLines="50" w:afterLines="25" w:line="300" w:lineRule="exact"/></w:pPr><w:r><w:t>x</w:t></w:r></w:p>"#;
+    let d = wordcraft_docx::read(&docx(body, &[], &[])).unwrap();
+    let p = &paras(&d)[0].props;
+    assert_eq!((p.space_before_lines, p.space_after_lines), (Some(0.5), Some(0.25)));
+    let again = wordcraft_docx::read(&wordcraft_docx::write(&d).unwrap()).unwrap();
+    let q = &paras(&again)[0].props;
+    assert_eq!((q.space_before_lines, q.space_after_lines), (Some(0.5), Some(0.25)));
+}
