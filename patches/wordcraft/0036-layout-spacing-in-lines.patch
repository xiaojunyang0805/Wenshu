+/// Spacing in lines is lines of the section's line grid, or of 12 pt without one, and overrides
+/// the spacing in points (WPS: `afterLines="100"` is 16.45 pt on a 329-twip grid, 12 pt without).
+#[test]
+fn spacing_in_lines_counts_grid_lines() {
+    let gap = |grid: bool| {
+        let mut d = if grid { with_grid("one\ntwo", DocGridType::Lines, 0) } else { with_grid("one\ntwo", DocGridType::Default, 0) };
+        if let Some(Block::Para(p)) = d.body.first_mut().map(std::sync::Arc::make_mut) {
+            p.props.space_after = Some(30.0);
+            p.props.space_after_lines = Some(1.0);
+        }
+        let l = lay(&d);
+        let ys: Vec<f32> = l.pages[0]
+            .items
+            .iter()
+            .filter_map(|i| if let Placed::Lines { y, para, l0, .. } = i { Some(y + para.lines[*l0].baseline - para.lines[*l0].top) } else { None })
+            .collect();
+        (ys[1] - ys[0], lines(&lay(&with_grid("one", if grid { DocGridType::Lines } else { DocGridType::Default }, 0))).1[0])
+    };
+    let (g, line) = gap(true);
+    assert!((g - line - 18.0).abs() < 0.01, "one grid line (18 pt) after, not 30: gap {g}, line {line}");
+    let (n, line) = gap(false);
+    assert!((n - line - 12.0).abs() < 0.01, "12 pt without a line grid: gap {n}, line {line}");
+    // A count of 0 leaves the spacing in points (WPS).
+    let mut d = with_grid(
+        "one
+two",
+        DocGridType::Lines,
+        0,
+    );
+    if let Some(Block::Para(p)) = d.body.first_mut().map(std::sync::Arc::make_mut) {
+        p.props.space_after = Some(30.0);
+        p.props.space_after_lines = Some(0.0);
+    }
+    let l = lay(&d);
+    let ps: Vec<_> =
+        l.pages[0].items.iter().filter_map(|i| if let Placed::Lines { para, .. } = i { Some(para.rp.space_after) } else { None }).collect();
+    assert!((ps[0] - 30.0).abs() < 0.01, "afterLines 0 keeps 30 pt: {}", ps[0]);
+}
