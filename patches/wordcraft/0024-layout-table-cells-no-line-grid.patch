+/// Lines in a table cell keep their natural height on a line grid unless the document says
+/// `adjustLineHeightInTable` (WPS, modes 14 and 15): then they take whole pitches as the body's do.
+#[test]
+fn table_cells_snap_to_the_line_grid_only_when_adjusted() {
+    use wordcraft_doc::{Path, Table};
+    let mut d = with_grid("Grid line", DocGridType::Lines, 0);
+    let mut t = Table::new(1, 1, 300.0);
+    let mut p = wordcraft_doc::Paragraph::with_text("Cell line", Default::default());
+    p.props.space_before = Some(0.0);
+    p.props.space_after = Some(0.0);
+    p.props.line_spacing = Some(LineSpacing::Multiple(1.0));
+    t.rows[0].cells[0].blocks = vec![wordcraft_doc::para_block(p)];
+    d.insert_block(StoryRef::Body, &Path::top(1), Block::Table(t)).unwrap();
+    let height = |d: &Document, cell: bool| {
+        lay(d).pages[0]
+            .items
+            .iter()
+            .find_map(|i| match i {
+                Placed::Lines { para, path, .. } if (path.0.len() > 1) == cell => para.lines.first().map(|line| line.height),
+                _ => None,
+            })
+            .unwrap()
+    };
+    let (body, cell) = (height(&d, false), height(&d, true));
+    assert!((body / 18.0 - (body / 18.0).round()).abs() < 1e-3, "body line {body} takes whole pitches");
+    assert!(cell < body - 1.0, "the cell's line keeps its own height ({cell}), the body's snaps ({body})");
+    d.settings.adjust_line_height_in_table = true;
+    assert!((height(&d, true) - body).abs() < 1e-3, "adjusted, the cell's line snaps like the body's");
+}
