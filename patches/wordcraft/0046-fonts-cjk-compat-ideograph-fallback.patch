+/// The face WPS Office on Windows draws a CJK compatibility ideograph (U+F900–FAFF, a 理 written
+/// U+F9E4) in when the run's font lacks it: Microsoft JhengHei UI for 宋体, 仿宋 and 新細明體 runs
+/// (Windows font linking), measured; then Microsoft JhengHei.
+pub(super) const CJK_COMPAT_FALLBACK_FAMILY: &str = "Microsoft JhengHei UI";
+
+/// Whether `c` is a CJK compatibility ideograph.
+pub(super) fn cjk_compat(c: char) -> bool {
+    matches!(u32::from(c), 0xF900..=0xFAFF | 0x2F800..=0x2FA1F)
+}
+
+/// How a face ranks among the fallbacks for the CJK character `c` (lower first): compatibility
+/// ideographs prefer Microsoft JhengHei UI, then Microsoft JhengHei; every CJK character then
+/// prefers 宋体 ([`CJK_FALLBACK_FAMILY`]).
+pub(super) fn cjk_rank(c: char, f: &FontFace) -> u8 {
+    if cjk_compat(c) {
+        if f.family.eq_ignore_ascii_case(CJK_COMPAT_FALLBACK_FAMILY) {
+            return 0;
+        }
+        if f.family.eq_ignore_ascii_case("Microsoft JhengHei") {
+            return 1;
+        }
+    }
+    if prefers_for_cjk(f) { 2 } else { 3 }
+}
+
