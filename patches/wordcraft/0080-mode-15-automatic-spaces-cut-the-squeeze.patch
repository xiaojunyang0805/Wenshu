+#[test]
+fn the_mode_15_limit_follows_wps_with_automatic_spaces() {
+    let cases = [(2.0, 21.0, 0, 0.76), (2.0, 21.5, 2, 0.61), (2.0, 22.0, 4, 0.55), (2.0, 22.0, 8, 0.46), (4.0, 22.0, 4, 0.66), (2.0, 33.0, 4, 0.50)];
+    for (k, n, g, wps) in cases {
+        let got = crate::para::justified_squeeze(k, n, g);
+        assert!((got - wps).abs() <= 0.05, "{k} marks, {n} em, {g} spaces: {got} em, WPS {wps}");
+    }
+}
