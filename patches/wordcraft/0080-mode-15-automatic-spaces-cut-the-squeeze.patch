+/// Mode 15, justified: automatic spaces beside digits aren't squeezed, but each cuts what the marks
+/// may give, by 1 / (1 + 0.08 g) for g of them (WPS sweeps: two commas and two digit runs on a
+/// 22-unit line give up 0.54 em in all, not the 0.74 of the same line's commas without digits).
+#[test]
+fn mode_15_automatic_spaces_cut_the_marks_squeeze() {
+    if !full_width_marks() {
+        return;
+    }
+    let text = "甲中中中，中12中中中34中中，中中中中中中中瑞国国国";
+    let n = text.chars().count() - 3;
+    let lay15 = |width: Option<f32>| {
+        let mut d = doc(text, CharSpacing::CompressPunctuation, width);
+        d.settings.compat_mode = 15;
+        if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+            p.props.align = Some(Align::Justify);
+            p.props.auto_space_dn = Some(true);
+        }
+        first_para(&lay(&d))
+    };
+    let g = lay15(None);
+    assert!(!g.auto_space.is_empty(), "automatic spaces beside the digits");
+    let natural = (g.lines[0].xs[n] - g.lines[0].xs[0]) / SIZE;
+    let chars = |w: f32| {
+        let g = lay15(Some(w));
+        g.lines[0].c1 - g.lines[0].c0
+    };
+    assert_eq!(chars(natural - 0.53), n, "0.53 em is within what the line squeezes");
+    assert!(chars(natural - 0.58) < n, "0.58 em is more than a line with four automatic spaces squeezes");
+}
