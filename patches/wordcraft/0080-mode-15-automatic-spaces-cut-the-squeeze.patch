+/// The squeeze a justified mode-15 line allows in all, in ems, before what its last unit adds:
+/// k / (k + n/32) for k marks on a line n em long before its last unit (F41), cut by
+/// 1 / (1 + 0.08 g) for g automatic spaces beside digits or Latin text, which aren't squeezed
+/// themselves (WPS sweeps, 20- and 30-unit lines, 1–4 marks, 1–4 digit runs: within 0.05 em).
+pub(crate) fn justified_squeeze(k: f32, n: f32, g: usize) -> f32 {
+    k / (k + n / 32.0) / (1.0 + 0.08 * g.min(1000) as f32)
+}
