+
+/// A paragraph that starts with a column break has its space before at the top of the next
+/// column in compatibility modes before 15, and none there in mode 15 (WPS Office).
+#[test]
+fn space_before_after_a_leading_column_break_by_mode() {
+    use wordcraft_doc::para::COLUMN_BREAK;
+    let top = |mode: u32, before: f32| {
+        let mut d = Document::new();
+        d.settings.compat_mode = mode;
+        let mut first = Paragraph::with_text("first", Default::default());
+        first.props.space_after = Some(0.0);
+        let mut p = Paragraph::with_text(&format!("{COLUMN_BREAK}PROBE"), Default::default());
+        p.props.space_before = Some(before);
+        p.props.space_after = Some(0.0);
+        d.body = vec![wordcraft_doc::para_block(first), wordcraft_doc::para_block(p)];
+        let l = lay(&d);
+        let c = l.caret(&Pos::body(1, COLUMN_BREAK.len_utf8())).unwrap();
+        (c.page, c.top)
+    };
+    for mode in [12, 14, 15] {
+        let (page, plain) = top(mode, 0.0);
+        let (_, spaced) = top(mode, 24.0);
+        assert_eq!(page, 1, "one column: the break starts the next page");
+        let want = if mode < 15 { 24.0 } else { 0.0 };
+        assert!((spaced - plain - want).abs() < 0.05, "mode {mode}: {spaced} vs {}", plain + want);
+    }
+}
