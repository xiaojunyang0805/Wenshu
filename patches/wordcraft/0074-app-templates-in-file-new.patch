+/// The embedding app's templates whose caption, category or id contains `query`
+/// (case-insensitive); all of them for an empty query.
+fn matching_app_templates(query: &str) -> Vec<&'static wordcraft_engine::io::AppTemplate> {
+    matching_app_templates_in(wordcraft_engine::io::app_templates(), query)
+}
+
+fn matching_app_templates_in<'a>(templates: &'a [wordcraft_engine::io::AppTemplate], query: &str) -> Vec<&'a wordcraft_engine::io::AppTemplate> {
+    let q = query.trim().to_lowercase();
+    templates.iter().filter(|t| q.is_empty() || [t.label, t.category, t.id].iter().any(|s| s.to_lowercase().contains(&q))).collect()
+}
