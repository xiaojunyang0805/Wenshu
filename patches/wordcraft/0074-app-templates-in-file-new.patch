+/// A template the embedding app adds to File › New (a Chinese app's official-document kinds,
+/// say): `file.new` with its `id` opens a new, untitled document from the Word document `docx`
+/// returns, read as `file.open` reads one.
+pub struct AppTemplate {
+    /// The `file.new` template id; one of WordCraft's own (`blank`, `sample`…) is ignored.
+    pub id: &'static str,
+    /// The gallery's caption (shown as given, not translated).
+    pub label: &'static str,
+    /// The heading New shows the app's templates under, a gallery row per category.
+    pub category: &'static str,
+    /// The template as a Word document (`.docx` bytes), given its `id`.
+    pub docx: fn(&str) -> Result<Vec<u8>, String>,
+}
+
+static APP_TEMPLATES: std::sync::OnceLock<Vec<AppTemplate>> = std::sync::OnceLock::new();
+
+/// WordCraft's own `file.new` templates, which an app template can't replace.
+pub const BUILT_IN_TEMPLATES: &[&str] = &["blank", "sample", "letter", "resume", "report"];
+
+/// Install the embedding app's templates, once per process (later calls are ignored and return
+/// false).
+pub fn set_app_templates(templates: Vec<AppTemplate>) -> bool {
+    APP_TEMPLATES.set(templates.into_iter().filter(|t| !t.id.is_empty() && !BUILT_IN_TEMPLATES.contains(&t.id)).collect()).is_ok()
+}
+
+/// The embedding app's templates ([`set_app_templates`]).
+pub fn app_templates() -> &'static [AppTemplate] {
+    APP_TEMPLATES.get().map_or(&[], Vec::as_slice)
+}
