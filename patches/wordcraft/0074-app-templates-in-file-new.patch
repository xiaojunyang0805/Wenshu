+//! An app built on WordCraft adds templates to File › New: `file.new` opens them by id. The list
+//! is process-wide, so no other test here adds templates.
+
+use serde_json::json;
+use wordcraft_engine::Session;
+use wordcraft_engine::io::{AppTemplate, app_templates, set_app_templates};
+
+fn notice(_id: &str) -> Result<Vec<u8>, String> {
+    let mut doc = wordcraft_doc::Document::from_text("App template notice");
+    doc.core.title = String::new();
+    wordcraft_engine::io::save_bytes("notice.docx", &doc)
+}
+
+fn broken(_id: &str) -> Result<Vec<u8>, String> {
+    Err("no such template file".into())
+}
+
+#[test]
+fn file_new_opens_an_app_template_by_id() {
+    let t = |id, docx| AppTemplate { id, label: "Notice", category: "Official", docx };
+    assert!(set_app_templates(vec![t("notice", notice), t("broken", broken), t("sample", notice)]));
+    assert!(!set_app_templates(Vec::new()), "only the first list counts");
+    // WordCraft's own ids stay WordCraft's.
+    assert_eq!(app_templates().iter().map(|t| t.id).collect::<Vec<_>>(), ["notice", "broken"]);
+    let mut s = Session::new(wordcraft_doc::Document::new());
+    s.run("file.new", &json!({"template": "notice"})).unwrap();
+    assert!(s.doc.body.iter().filter_map(|b| b.as_para()).any(|p| p.plain_text() == "App template notice"));
+    assert!(s.path.is_none(), "untitled: saving asks where");
+    let err = s.run("file.new", &json!({"template": "broken"})).unwrap_err().to_string();
+    assert!(err.contains("no such template file"), "{err}");
+    // An unknown id is a blank document, as before.
+    s.run("file.new", &json!({"template": "unknown"})).unwrap();
+    assert!(s.doc.body.iter().filter_map(|b| b.as_para()).all(|p| p.plain_text().is_empty()));
+}
