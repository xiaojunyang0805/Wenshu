+/// An app template's document ([`crate::io::AppTemplate`]): its Word document, read in the
+/// session's region; untitled, so saving it asks where to write.
+fn app_template_document(s: &Session, t: &crate::io::AppTemplate) -> Result<Document, CmdError> {
+    let bytes = (t.docx)(t.id).map_err(|e| CmdError::Failed(format!("template {}: {e}", t.label)))?;
+    let (doc, _) = crate::io::open_bytes_in("template.docx", &bytes, None, &s.region()).map_err(CmdError::Failed)?;
+    Ok(doc)
+}
