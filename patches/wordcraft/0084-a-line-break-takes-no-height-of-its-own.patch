+/// A line break in a larger run takes no height of its own: the line it ends is as tall as with a
+/// break at the text's size (WPS, both modes, with and without the line grid: a 20 pt break after
+/// 12 pt text). A line of only the break keeps its size.
+#[test]
+fn a_line_break_takes_no_height_of_its_own() {
+    crate::test_fonts();
+    let heights = |break_size: f32, text: &str| {
+        let mut d = Document::new();
+        d.body = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, Default::default()))];
+        d.format_range(&Pos::body(0, 0), &Pos::body(0, text.len()), &|c| c.size = Some(12.0)).unwrap();
+        let at = text.find(wordcraft_doc::para::LINE_BREAK).unwrap();
+        d.format_range(&Pos::body(0, at), &Pos::body(0, at + 1), &|c| c.size = Some(break_size)).unwrap();
+        let l = lay(&d);
+        let para = l.pages[0].items.iter().find_map(|i| if let Placed::Lines { para, .. } = i { Some(para.clone()) } else { None }).unwrap();
+        para.lines.iter().map(|l| l.height).collect::<Vec<_>>()
+    };
+    let (small, large) = (
+        heights(
+            12.0,
+            "Text
+Next",
+        ),
+        heights(
+            20.0,
+            "Text
+Next",
+        ),
+    );
+    assert!((small[0] - large[0]).abs() < 0.01, "a 20 pt break: {large:?}, a 12 pt one: {small:?}");
+    let (small, large) = (
+        heights(
+            12.0, "
+Next",
+        ),
+        heights(
+            20.0, "
+Next",
+        ),
+    );
+    assert!(large[0] > small[0] + 2.0, "a line of only the break keeps its size: {large:?} vs {small:?}");
+}
