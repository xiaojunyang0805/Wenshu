 /// Formats WordCraft saves (Save As).
 pub const SAVE_EXTS: &[&str] = &["docx", "docm", "dotx", "dotm", "pdf", "txt", "md", "html", "rtf", "odt", "tex", "png", "json", "xml"];
 
+/// A format the embedding app saves (an export: the document keeps its own file), offered by Save
+/// As and File › Export after WordCraft's own and written by `write`. Wenshu adds OFD this way.
+#[derive(Clone, Copy, Debug)]
+pub struct AppFormat {
+    /// The extension, lower-case, without the dot.
+    pub ext: &'static str,
+    /// What the file-type list and File › Export call it (shown as given, not translated).
+    pub name: &'static str,
+    pub write: fn(&Document) -> Result<Vec<u8>, String>,
+}
+
+static APP_FORMATS: std::sync::OnceLock<Vec<AppFormat>> = std::sync::OnceLock::new();
+
+/// Install the embedding app's save formats, once per process (later calls are ignored and
+/// return false). A format with one of WordCraft's own extensions is ignored.
+pub fn set_app_formats(formats: Vec<AppFormat>) -> bool {
+    let own = |e: &str| SAVE_EXTS.contains(&e) || e == "text";
+    APP_FORMATS.set(formats.into_iter().filter(|f| !own(f.ext) && !f.ext.is_empty()).collect()).is_ok()
+}
+
+/// The embedding app's save formats ([`set_app_formats`]).
+pub fn app_formats() -> &'static [AppFormat] {
+    APP_FORMATS.get().map_or(&[], Vec::as_slice)
+}
+
+/// Every extension Save As offers: WordCraft's own ([`SAVE_EXTS`]) then the app's.
+pub fn save_exts() -> Vec<&'static str> {
+    SAVE_EXTS.iter().copied().chain(app_formats().iter().map(|f| f.ext)).collect()
+}
