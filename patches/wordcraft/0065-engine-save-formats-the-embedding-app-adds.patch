diff --git a/crates/engine/src/tests/app_formats.rs b/crates/engine/src/tests/app_formats.rs
new file mode 100644
index 00000000..84b213b0
--- /dev/null
+++ b/crates/engine/src/tests/app_formats.rs
@@ -0,0 +1,28 @@
+//! Formats the embedding app saves (`io::set_app_formats`): written by the app's function,
+//! offered after WordCraft's own, never in place of one of them. (The list is set once per
+//! process, so this is the only test that sets it.)
+
+use crate::io::{AppFormat, app_formats, save_bytes, save_exts, set_app_formats};
+
+fn sample(doc: &wordcraft_doc::Document) -> Result<Vec<u8>, String> {
+    Ok(format!("paragraphs: {}", doc.body.len()).into_bytes())
+}
+
+#[test]
+fn an_app_format_is_saved_by_the_app() {
+    let first = set_app_formats(vec![
+        AppFormat { ext: "zzz", name: "Sample", write: sample },
+        // One of WordCraft's own: ignored, PDF stays WordCraft's.
+        AppFormat { ext: "pdf", name: "Not PDF", write: sample },
+    ]);
+    assert!(first);
+    assert!(!set_app_formats(Vec::new()), "set once");
+    assert_eq!(app_formats().len(), 1);
+    let exts = save_exts();
+    assert_eq!(exts.last(), Some(&"zzz"));
+    assert_eq!(exts.iter().filter(|e| **e == "pdf").count(), 1);
+    let doc = wordcraft_doc::Document::new();
+    assert_eq!(save_bytes("out.zzz", &doc).unwrap(), b"paragraphs: 1".to_vec());
+    assert_eq!(save_bytes("OUT.ZZZ", &doc).unwrap(), b"paragraphs: 1".to_vec());
+    assert!(save_bytes("out.pdf", &doc).unwrap().starts_with(b"%PDF"));
+}
