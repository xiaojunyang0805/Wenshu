+#[test]
+fn character_indents_on_a_character_grid_count_the_texts_advance() {
+    // Text larger than the grid's default size: a character of indent is what the text advances
+    // (its size plus the grid adjustment), not one cell: WPS indents 16 pt text by 2 × 15.54 pt on
+    // a grid made for 10.5 pt. The left indent counts the larger of the text's and the mark's.
+    let (mut d, size, pitch) = tight_grid(&"中".repeat(200));
+    let text = size * 1.5;
+    if let Some(Block::Para(p)) = d.body.first_mut().map(std::sync::Arc::make_mut) {
+        p.runs[0].props.size = Some(text);
+        p.mark.size = Some(text);
+    }
+    let with = |f: &dyn Fn(&mut wordcraft_doc::Paragraph)| {
+        let mut d = d.clone();
+        if let Some(Block::Para(p)) = d.body.first_mut().map(std::sync::Arc::make_mut) {
+            f(p);
+        }
+        first_para(&lay(&d))
+    };
+    let cell = text + pitch - size;
+    let first = with(&|p| p.props.indent_first_chars = Some(2.0));
+    let indent = first.lines[0].xs[0] - first.lines[1].xs[0];
+    assert!((indent - 2.0 * cell).abs() < 0.01, "first-line indent {indent}, want {}", 2.0 * cell);
+    let base = with(&|_| {});
+    let left = with(&|p| {
+        p.props.indent_left_chars = Some(2.0);
+        p.mark.size = Some(text * 1.5);
+    });
+    let want = 2.0 * (text * 1.5 + pitch - size);
+    assert!((left.lines[1].left - base.lines[1].left - want).abs() < 0.01, "left {}, want {want}", left.lines[1].left - base.lines[1].left);
+}
