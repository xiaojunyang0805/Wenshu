+#[test]
+fn a_line_may_break_before_an_opening_curly_quote_between_ideographs() {
+    // Unicode 15.1 LB19a: "确保|“双减”" breaks before the quote, as WPS does; Unicode 15.0
+    // never broke beside a curly quote, so the line lost 保 as well. Kinsoku still keeps the
+    // closing quote off the next line's start.
+    let text = format!("{}确保“双减”，工作平稳有序", "中".repeat(18));
+    let mut d = doc(&text, CharSpacing::DoNotCompress, Some(20.2));
+    if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+        p.runs[0].props.hint_ea = Some(true);
+    }
+    let g = first_para(&lay(&d));
+    assert_eq!(g.lines[0].c1 - g.lines[0].c0, 20, "the first line ends after 保");
+    for l in &g.lines {
+        let first = g.clusters.get(l.c0).and_then(|c| text.get(c.start..)).and_then(|t| t.chars().next());
+        assert!(!matches!(first, Some('”' | '，')), "a line starts with {first:?}");
+    }
+}
