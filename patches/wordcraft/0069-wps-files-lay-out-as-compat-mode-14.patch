+/// The first cell's text x of a two-column table, start- or end-aligned, in compatibility mode
+/// `mode`, in a file WPS Office wrote (`wps`) or not.
+fn table_text_x(mode: u32, wps: bool, align: Option<Align>) -> f32 {
+    let mut d = Document::new();
+    d.settings.compat_mode = mode;
+    d.settings.wps_layout = wps;
+    let mut t = Table::new(1, 2, 200.0);
+    t.props.style = None;
+    t.props.borders = None;
