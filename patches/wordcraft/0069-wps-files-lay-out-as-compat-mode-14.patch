+    d.body = vec![Arc::new(wordcraft_doc::Block::Table(t))];
+    let l = lay(&d);
+    l.pages[0]
+        .items
+        .iter()
+        .find_map(|i| match i {
+            Placed::Lines { x, .. } => Some(*x),
+            _ => None,
+        })
+        .unwrap()
+}
