+/// Before Word 2013 layout a table's position places its text: a start-aligned table moves out by
+/// its first cell's left margin, an end-aligned one by its last cell's right margin. WPS Office
+/// lays out a file it wrote that way in every mode (measured in WPS 12.1).
+#[test]
+fn tables_place_their_text_before_word_2013_and_in_wps_files() {
+    crate::test_fonts();
+    for align in [None, Some(Align::Right)] {
+        let modern = table_text_x(15, false, align);
+        let shift = if align.is_some() { 5.4 } else { -5.4 };
+        for (mode, wps) in [(14, false), (14, true), (15, true)] {
+            let x = table_text_x(mode, wps, align);
+            assert!((x - modern - shift).abs() < 0.01, "{align:?} mode {mode} wps {wps}: {x}, mode 15 {modern}");
+        }
+    }
+}
