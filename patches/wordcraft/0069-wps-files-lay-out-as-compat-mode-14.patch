+/// Before Word 2013 layout (compatibility mode 15) a table's position places its text, not its
+/// border: a start-aligned table's edge sits its first cell's left margin further out, and an
+/// end-aligned one's its last cell's right margin (measured in WPS 12.1, which lays out a file it
+/// wrote this way in every mode). `None` in mode 15; else the (left, right) shifts.
+pub(crate) fn legacy_margins(ctx: &Ctx, t: &Table) -> Option<[f32; 2]> {
+    if ctx.doc.settings.layout_compat_mode() >= 15 {
+        return None;
+    }
+    let def = default_margins(t, table_style(ctx, t).as_ref());
+    Some([first_cell_left_margin_in(t, def), last_cell_right_margin_in(t, def)])
+}
