+#[test]
+fn wps_office_application_turns_on_wps_layout() {
+    let read_app = |application: Option<&str>| {
+        let app = application.map(|a| format!(r#"<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"><Application>{a}</Application></Properties>"#));
+        let rel = [("rIdA", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties", "docProps/app.xml")];
+        let parts = app.as_deref().map(|a| vec![("docProps/app.xml", a)]).unwrap_or_default();
+        let b = package("<w:p><w:r><w:t>x</w:t></w:r></w:p>", &[], if app.is_some() { &rel[..] } else { &[] }, &parts);
+        wordcraft_docx::read(&b).unwrap().settings.wps_layout
+    };
+    assert!(read_app(Some("WPS Office_12.1.0.17857_F1E327BC-269C-435d-A152-05C5408002CA")));
+    for other in [Some("Microsoft Office Word"), Some("wps office"), Some("Kingsoft Office"), None] {
+        assert!(!read_app(other), "{other:?}");
+    }
+}
