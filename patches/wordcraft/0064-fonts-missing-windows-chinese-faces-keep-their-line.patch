+/// A Windows Chinese face's East Asian line in ems, from its win ascent and descent.
+fn windows_line(win_ascent: f64, win_descent: f64, upem: f64) -> Option<(f64, f64)> {
+    east_asian_line(0x0004_0000, win_ascent, win_descent, upem).map(|(a, d)| (a / upem, d / upem))
+}
