+/// A cell's longest word needs only its line's indent: a hanging indent takes the left indent
+/// back for the first line (WPS keeps an 88 pt column for a 70 pt word under `w:left="958"
+/// w:hanging="958"`), so the column keeps its grid width where a plain left indent widens it.
+#[test]
+fn a_hanging_indent_leaves_the_first_word_its_column() {
+    crate::test_fonts();
+    let word = "Unbreakable";
+    let w = {
+        let l = lay(&Document::from_text(word));
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        para.x_of(0, word.len()).unwrap() - para.x_of(0, 0).unwrap()
+    };
+    let second_column = |left: f32, first: f32| {
+        let mut p = wordcraft_doc::Paragraph::with_text(word, Default::default());
+        p.props.indent_left = Some(left);
+        p.props.indent_first = Some(first);
+        let mut t = Table::new(1, 2, 468.0);
+        t.grid = vec![w + 14.0, 454.0 - w];
+        t.rows[0].cells[0].props.width = Some(w + 14.0);
+        t.rows[0].cells[1].props.width = Some(454.0 - w);
+        t.rows[0].cells[0].blocks = vec![wordcraft_doc::para_block(p)];
+        t.rows[0].cells[1].blocks = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text("B", Default::default()))];
+        let mut d = Document::from_text("After");
+        d.insert_block(StoryRef::Body, &Path::top(0), wordcraft_doc::Block::Table(t)).unwrap();
+        para_at(&lay(&d), &[0, 0, 1, 0]).first().map_or(0.0, |p| p.0)
+    };
+    let (none, hanging, left) = (second_column(0.0, 0.0), second_column(30.0, -30.0), second_column(30.0, 0.0));
+    assert!((hanging - none).abs() < 0.01, "with a hanging indent the second column starts at {hanging}, {none} without");
+    assert!(left > none + 1.0, "a plain left indent widens the first column: {left} vs {none}");
+}
