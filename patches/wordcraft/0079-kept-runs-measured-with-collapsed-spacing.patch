+/// A run of headings kept with the next paragraph moves to the next page only when it doesn't fit:
+/// its height counts the larger of a heading's space after and the next one's space before, as
+/// the headings are placed, not their sum (13 headings with 13 pt before and after fit a page in
+/// WPS; counted with the sums the run seemed too tall and went over, leaving a page short).
+#[test]
+fn a_run_of_kept_headings_is_measured_with_its_spacing_collapsed() {
+    let exact = |h: f32| Some(wordcraft_doc::props::LineSpacing::Exactly(h));
+    // The page the first heading lands on after `fillers` lines of exactly 28 pt.
+    let first_heading_page = |fillers: usize| {
+        let mut d = Document::new();
+        let filler = ParaProps { space_before: Some(0.0), space_after: Some(0.0), line_spacing: exact(28.0), ..Default::default() };
+        let heading =
+            ParaProps { space_before: Some(13.0), space_after: Some(13.0), line_spacing: exact(18.0), keep_next: Some(true), ..Default::default() };
+        let para = |text: &str, props: &ParaProps| {
+            let mut x = wordcraft_doc::Paragraph::with_text(text, Default::default());
+            x.props = props.clone();
+            wordcraft_doc::para_block(x)
+        };
+        d.body = (0..fillers).map(|i| para(&format!("F{i}"), &filler)).collect();
+        d.body.extend((0..10).map(|i| para(&format!("H{i}"), &heading)));
+        d.body.push(para("Body", &filler));
+        let l = lay(&d);
+        let body = (d.last_section.page_h - d.last_section.margin_top - d.last_section.margin_bottom, fillers);
+        let page = l
+            .pages
+            .iter()
+            .position(|p| p.items.iter().any(|i| matches!(i, Placed::Lines { path, .. } if path.0.first().is_some_and(|&b| b as usize == fillers))));
+        (page, body)
+    };
+    let last = (1..40).take_while(|n| first_heading_page(*n).0 == Some(0)).last().expect("a filler count leaving the heading on page 1");
+    let (_, (body, n)) = first_heading_page(last);
+    let room = body - n as f32 * 28.0;
+    // The heading measures the next eight with it: 13 + 9 x 18 + 8 x 13 (+ the next's first line)
+    // collapsed, 9 x 44 with the sums.
+    assert!(room < 9.0 * 44.0, "the run started with {room} pt left: measured with its spacing summed");
+}
+
