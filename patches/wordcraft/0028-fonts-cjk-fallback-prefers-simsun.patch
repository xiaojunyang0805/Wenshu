+/// Chinese characters a run's font lacks fall back to 宋体 first, as WPS draws them, even when
+/// another face covering them (Microsoft YaHei, say) was loaded before it; other characters
+/// keep the usual order.
+#[test]
+fn chinese_characters_fall_back_to_simsun_before_other_loaded_faces() {
+    let db = FontDb::with_font_dirs(Vec::new());
+    db.set_system_fallback(false);
+    db.add_document_fonts(vec![(named_face("SourceSerif4-Regular.ttf", "Other Face"), "Other Face".to_string())], 0);
+    db.add_document_fonts(vec![(named_face("SourceSerif4-Regular.ttf", "SimSun"), "SimSun".to_string())], 0);
+    let faces = db.read_faces();
+    let first = |cjk: bool| super::fallback_data::fallback_order(&faces, u32::MAX, false, None, cjk).first().map(|f| f.family.clone());
+    assert_eq!(first(true).as_deref(), Some("SimSun"));
+    assert_ne!(first(false).as_deref(), Some("SimSun"), "Latin characters keep the usual order");
+}
