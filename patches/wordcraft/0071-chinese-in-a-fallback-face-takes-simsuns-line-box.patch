+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Only the run's East Asian fallback face counts, not a font the run names (its installed
+    /// East Asian font), and not for Hangul.
+    #[test]
+    fn chinese_fallback_is_the_fallback_face_drawing_chinese() {
+        let db = wordcraft_fonts::FontDb::global();
+        let fallback = Some(FaceRef::of(&db.face("Source Serif 4", "Regular")));
+        let named = Some(FaceRef::of(&db.face("Source Sans 3", "Regular")));
+        assert!(chinese_fallback(fallback, fallback, named, "永嘉县文件"));
+        assert!(chinese_fallback(fallback, fallback, None, "永嘉县，文件"));
+        assert!(!chinese_fallback(named, fallback, named, "永嘉县文件"), "the run's own East Asian font");
+        assert!(!chinese_fallback(fallback, fallback, fallback, "永嘉县文件"), "the fallback is the font it names");
+        assert!(!chinese_fallback(None, fallback, None, "永嘉县文件"), "the run's primary face");
+        assert!(!chinese_fallback(fallback, fallback, None, "한국어"), "Hangul");
+    }
