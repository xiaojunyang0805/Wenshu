+/// The line (ascent, descent) in ems of Chinese text a fallback face draws (the run's fonts lack
+/// it) where SimSun isn't installed: SimSun's, the face Chinese falls back to on Windows, not the
+/// fallback's own (Noto Sans CJK's made such lines 45% taller). `None` where SimSun is installed:
+/// it is the fallback there.
+pub fn chinese_fallback_line() -> Option<(f64, f64)> {
+    chinese_fallback_line_in(FontDb::global())
+}
+
+fn chinese_fallback_line_in(db: &FontDb) -> Option<(f64, f64)> {
+    if db.has_family("SimSun") {
+        return None;
+    }
+    windows_line(220.0, 36.0, 256.0)
+}
