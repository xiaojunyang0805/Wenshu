+/// Is `sub`, drawn in `face`, Chinese text in the run's East Asian fallback face (`ea_face`: the
+/// run's fonts lack it), not in a font it names? Hangul isn't: SimSun, which Chinese falls back
+/// to on Windows, lacks it.
+fn chinese_fallback(face: Option<FaceRef>, ea_face: Option<FaceRef>, primary_ea: Option<FaceRef>, sub: &str) -> bool {
+    let id = |f: Option<FaceRef>| f.map(|f| f.id());
+    face.is_some()
+        && id(face) == id(ea_face)
+        && id(face) != id(primary_ea)
+        && !sub.chars().any(|c| matches!(u32::from(c), 0x1100..=0x11FF | 0x3130..=0x318F | 0xA960..=0xA97F | 0xAC00..=0xD7FF))
+}
