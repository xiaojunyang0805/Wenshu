+
+/// Under `w:balanceSingleByteDoubleByteWidth` character spacing counts per byte: an East Asian
+/// (double-byte) character gets `w:spacing` twice, a Latin letter once (WPS Office: 16 pt 仿宋
+/// with −0.3 pt advances 15.4 pt, `H` keeps a single −0.3 pt).
+#[test]
+fn balanced_single_byte_width_doubles_east_asian_character_spacing() {
+    use wordcraft_doc::props::CharProps;
+    let adv = |text: &str, spacing: f32, balance: bool| {
+        let props = CharProps { size: Some(16.0), spacing: Some(spacing), ..Default::default() };
+        let mut d = Document::new();
+        d.body = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, props))];
+        d.settings.balance_sbcs_dbcs = balance;
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        para.clusters[0].adv
+    };
+    for balance in [false, true] {
+        let cjk = adv("中", -0.3, balance) - adv("中", 0.0, balance);
+        let latin = adv("H", -0.3, balance) - adv("H", 0.0, balance);
+        let want = if balance { -0.6 } else { -0.3 };
+        assert!((cjk - want).abs() < 0.01, "balance {balance}: 中 changes by {cjk}");
+        assert!((latin + 0.3).abs() < 0.01, "balance {balance}: H changes by {latin}");
+    }
+}
