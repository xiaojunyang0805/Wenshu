+/// ASCII text takes `w:ascii`; a style naming only `w:hAnsi` (the font of other Latin letters, é)
+/// keeps the font it inherits for it (WPS, both modes: `w:hAnsi="Arial"` over Times leaves Times
+/// digits; `dc-reports-2d6a9da333`'s heading 3 had its digits in Arial).
+#[test]
+fn a_font_named_only_for_hansi_leaves_ascii_text_its_inherited_font() {
+    let styles = r#"<w:style w:type="paragraph" w:styleId="Base"><w:name w:val="Base"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="SimSun"/></w:rPr></w:style><w:style w:type="paragraph" w:styleId="H"><w:name w:val="H"/><w:basedOn w:val="Base"/><w:rPr><w:rFonts w:hAnsi="Arial"/><w:bCs/></w:rPr></w:style>"#;
+    let body = r#"<w:p><w:pPr><w:pStyle w:val="H"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>110</w:t></w:r></w:p>"#;
+    let d = themed_docx(body, styles, None);
+    let rc = d.styles.resolve_char(Some("H"), paras(&d)[0].props_of_char(0));
+    assert_eq!(rc.font, "Times New Roman");
+    assert!(!rc.bold, "w:bCs is complex-script bold only");
+}
