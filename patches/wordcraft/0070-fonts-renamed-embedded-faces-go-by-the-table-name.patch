+/// A file a document embeds under a table name it doesn't go by (WPS embeds a SimSun subset as
+/// 黑体) goes by that name only: not by its own full, PostScript or localized names, or 宋体
+/// resolved to a few glyphs of SimSun where SimSun isn't installed.
+#[test]
+fn an_embedded_face_under_another_name_goes_by_that_name_only() {
+    let db = FontDb::with_font_dirs(Vec::new());
+    db.set_system_fallback(false);
+    let owner = crate::DocumentFonts::new_owner();
+    let song = with_family_names("SourceSans3-Regular.ttf", &[(0x0409, "Songti Test"), (0x0804, "测试宋体")]);
+    db.add_document_fonts(vec![(song, "测试黑体".to_string())], owner);
+    db.add_document_fonts(vec![(named_face("SourceSerif4-Regular.ttf", "Mingti Test"), "Other Table".to_string())], owner);
+    let _doc = crate::DocumentFonts::enter(owner);
+    assert!(db.has_family("测试黑体") && db.has_family("Other Table"), "the table's names");
+    for own in ["Songti Test", "测试宋体", "Mingti Test", "Mingti Test Regular", "MingtiTest-Regular"] {
+        assert!(!db.has_family(own), "{own}");
+    }
+    assert_eq!(db.english_family("测试宋体"), None);
+}
