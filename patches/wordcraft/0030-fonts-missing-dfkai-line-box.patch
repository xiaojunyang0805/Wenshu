+/// The (ascent, descent) in em WPS Office gives a line in a font it knows but this system lacks,
+/// when the text is drawn in a substitute: DFKai-SB (標楷體) keeps its own 1.3 em box, the
+/// baseline 0.95 em down (measured at 10.5, 16 and 22 pt, drawn in 宋体 or Microsoft JhengHei
+/// Light), where the substitute's own box would put it 1.0 em down.
+pub fn missing_font_line(family: &str, resolved: &Resolved) -> Option<(f64, f64)> {
+    if !resolved.substituted {
+        return None;
+    }
+    match family.trim().to_lowercase().as_str() {
+        "標楷體" | "标楷体" | "dfkai-sb" | "dfkai" => Some((0.95, 0.35)),
+        _ => None,
+    }
+}
+
 /// Is a line's (ascent, descent) one `upem` em tall?
 fn one_em((ascent, descent): (f64, f64), upem: f64) -> bool {
     upem > 0.0 && ((ascent + descent) / upem - 1.0).abs() < 0.005
@@ -987,6 +1001,19 @@ mod tests {
         assert_eq!(substitutes(charset_base_family("Times New Roman Cyr")), substitutes("Times New Roman"));
     }
 
+    #[test]
+    fn a_missing_dfkai_keeps_its_own_line_box() {
+        let mut r = resolve("Arial", false, false);
+        r.substituted = true;
+        for name in ["標楷體", "标楷体", "DFKai-SB", " dfkai-sb "] {
+            assert_eq!(missing_font_line(name, &r), Some((0.95, 0.35)), "{name}");
+        }
+        assert_eq!(missing_font_line("Arial", &r), None);
+        // Installed, the font's own metrics count.
+        r.substituted = false;
+        assert_eq!(missing_font_line("標楷體", &r), None);
+    }
