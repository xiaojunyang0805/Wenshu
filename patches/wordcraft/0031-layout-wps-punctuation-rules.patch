+/// Under `w:overflowPunct` (on unless turned off), a closing mark ending a line of Chinese,
+/// Japanese or Korean text (`w:lang/@w:eastAsia`) hangs whole past the margin, with or without
+/// compression (WPS: 34 characters and a `，` fit 34 em). Text tagged with another East Asian
+/// language, or with the switch off, keeps the usual rule.
+#[test]
+fn a_closing_mark_in_chinese_text_hangs_whole_under_overflow_punct() {
+    if !full_width_marks() {
+        return;
+    }
+    let text = format!("{}，下一行", "中".repeat(10));
+    let first_alt = |lang: Option<&str>, overflow: Option<bool>, alt: bool| {
+        let mut d = doc(&text, CharSpacing::DoNotCompress, Some(10.0));
+        d.settings.alt_kinsoku = alt;
+        if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+            p.props.overflow_punct = overflow;
+            for r in &mut p.runs {
+                r.props.lang_ea = lang.map(str::to_string);
+            }
+        }
+        let g = first_para(&lay(&d));
+        g.lines[0].c1 - g.lines[0].c0
+    };
+    let first = |lang: Option<&str>, overflow: Option<bool>| first_alt(lang, overflow, false);
+    assert_eq!(first(Some("zh-CN"), None), 11, "the comma hangs");
+    assert_eq!(first(Some("ja-JP"), None), 11, "in Japanese text too");
+    assert_eq!(first(Some("zh-CN"), Some(false)), 9, "switched off, the comma needs room: 中， moves down");
+    assert_eq!(first(Some("en-US"), None), 9, "text tagged en-US keeps the usual rule");
+    assert_eq!(first(None, None), 9, "untagged text too");
+    assert_eq!(first_alt(Some("zh-CN"), None, true), 9, "useAltKinsokuLineBreakRules turns hanging off");
+}
+
+/// Kerned text (`w:kern`) closes up adjacent full-width marks by half an em, compressed or not,
+/// unless the document says `w:noPunctuationKerning`; curly quotes take no part (WPS: `中》《中`
+/// advances 》 by 8 pt at 16 pt, `中）“中` keeps 16).
+#[test]
+fn kerned_text_closes_up_adjacent_marks_by_half_an_em() {
+    if !full_width_marks() {
+        return;
+    }
+    let adv = |text: &str, kern: Option<f32>, no_kerning: bool| {
+        let mut d = doc(text, CharSpacing::DoNotCompress, None);
+        d.settings.no_punctuation_kerning = no_kerning;
+        if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+            for r in &mut p.runs {
+                r.props.kern = kern;
+            }
+        }
+        first_para(&lay(&d)).clusters.get(1).map(|c| c.adv).unwrap_or_default()
+    };
+    assert!((adv("中》《中", Some(1.0), false) - SIZE / 2.0).abs() < 0.01, "》《 closes up");
+    assert!((adv("中（《中", Some(1.0), false) - SIZE / 2.0).abs() < 0.01, "（《 closes up");
+    assert!((adv("中》《中", Some(0.0), false) - SIZE).abs() < 0.01, "not kerned");
+    assert!((adv("中》《中", Some(1.0), true) - SIZE).abs() < 0.01, "noPunctuationKerning");
+    assert!((adv("中》《中", Some(20.0), false) - SIZE).abs() < 0.01, "below the kerning threshold");
+    assert!(adv("中）“中", Some(1.0), false) > SIZE * 0.9, "curly quotes stay");
+}
+
+/// A hanging closing mark and the squeeze of the marks before it add up: the line's other marks
+/// make room for its last characters and the closing mark hangs past the margin (WPS:
+/// `…协议、协调意见、` squeezes the first 、 and hangs the second).
+#[test]
+fn a_hanging_mark_adds_to_what_the_marks_before_it_squeeze() {
+    if !full_width_marks() {
+        return;
+    }
+    // 8 + 1 + 2 = 11 em before the last 、, in 10.5 em: the first 、 gives up half an em.
+    let text = format!("{}、中中、下一行", "中".repeat(8));
+    let first = |lang: Option<&str>| {
+        let mut d = doc(&text, CharSpacing::CompressPunctuation, Some(10.5));
+        if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+            for r in &mut p.runs {
+                r.props.lang_ea = lang.map(str::to_string);
+            }
+        }
+        let g = first_para(&lay(&d));
+        g.lines[0].c1 - g.lines[0].c0
+    };
+    assert_eq!(first(Some("zh-CN")), 12, "squeeze and hang together");
+    assert!(first(None) < 12, "without the hang the line breaks earlier");
+}
