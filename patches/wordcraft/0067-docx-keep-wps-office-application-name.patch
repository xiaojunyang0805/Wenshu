+/// The producing application's name, kept (as an [`APP_KEPT`] line) only when it names WPS
+/// Office: WPS lays out a file whose `Application` contains `WPS Office` by its own rules and any
+/// other file (Word's, WordCraft's, none) by different ones, so writing our own name would change
+/// how WPS lays out a document it wrote (WPS 12.1, measured: page counts of two documents moved
+/// by one and two pages). Any other application's name is replaced by WordCraft's.
+pub const APP_KEPT_APPLICATION: &str = "Application";
+
+/// Whether an `Application` value is WPS Office's (see [`APP_KEPT_APPLICATION`]).
+pub fn is_wps_application(value: &str) -> bool {
+    value.contains("WPS Office")
+}
