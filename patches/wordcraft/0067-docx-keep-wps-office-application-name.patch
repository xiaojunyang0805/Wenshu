+#[test]
+fn wps_office_keeps_its_application_name_so_wps_keeps_its_own_layout() {
+    let save_app = |application: &str| {
+        let app = format!(
+            r#"<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"><Template>Normal.dotm</Template><Pages>27</Pages><Company>C</Company><ScaleCrop>false</ScaleCrop><LinksUpToDate>false</LinksUpToDate><SharedDoc>false</SharedDoc><HyperlinksChanged>false</HyperlinksChanged><Manager>M</Manager><HyperlinkBase>h</HyperlinkBase><Application>{application}</Application></Properties>"#
+        );
+        let b = package(
+            "<w:p><w:r><w:t>x</w:t></w:r></w:p>",
+            &[],
+            &[("rIdA", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties", "docProps/app.xml")],
+            &[("docProps/app.xml", app.as_str())],
+        );
+        text(&save(&wordcraft_docx::read(&b).unwrap()), "docProps/app.xml")
+    };
+    let wps = save_app("WPS Office_12.1.0.17857_F1E327BC-269C-435d-A152-05C5408002CA");
+    assert!(wps.contains("<Application>WPS Office_12.1.0.17857_F1E327BC-269C-435d-A152-05C5408002CA</Application>"), "{wps}");
+    assert_eq!(wps.matches("<Application>").count(), 1, "{wps}");
+    // Every kept property is still written beside it (the last one too).
+    for kept in ["Template", "Company", "ScaleCrop", "LinksUpToDate", "SharedDoc", "HyperlinksChanged", "Manager", "HyperlinkBase"] {
+        assert!(wps.contains(&format!("<{kept}>")), "{kept}: {wps}");
+    }
+    assert!(!wps.contains("<Pages>"), "{wps}");
+    for other in ["Microsoft Office Word", "wps office", "Kingsoft Office"] {
+        let a = save_app(other);
+        assert!(a.contains("<Application>WordCraft</Application>") && !a.contains(other), "{other}: {a}");
+    }
+}
