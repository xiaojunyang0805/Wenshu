+/// The room a visible border takes across its edge: its width, or for a double or triple border
+/// all of its lines and the gaps between them, each as wide as the width (WPS, measured: rows
+/// under a 0.5 pt double border are 1 pt taller than under a single one, 3 pt at 1.5 pt, and
+/// 2 pt under a 0.5 pt triple one).
+fn band(b: Option<Border>) -> f32 {
+    b.filter(Border::is_visible).map_or(0.0, |b| {
+        let w = b.width.clamp(0.0, 12.0);
+        match b.style {
+            BorderStyle::Double => w * 3.0,
+            BorderStyle::Triple => w * 5.0,
+            _ => w,
+        }
+    })
