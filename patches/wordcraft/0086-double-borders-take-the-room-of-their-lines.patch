+/// A double or triple border takes the room of all its lines and gaps, each as wide as the
+/// border's width (WPS, measured: rows under 0.5 pt double borders 1 pt taller than under single
+/// ones, under triple ones 2 pt).
+#[test]
+fn a_double_border_takes_the_room_of_its_lines_and_gap() {
+    crate::test_fonts();
+    use wordcraft_doc::props::{Border, BorderStyle, Borders, HeightRule};
+    for (style, band) in [(BorderStyle::Single, 0.5), (BorderStyle::Double, 1.5), (BorderStyle::Triple, 2.5)] {
+        let mut d = Document::from_text("");
+        let line = Some(Border { style, width: 0.5, color: None, space: 0.0 });
+        let mut t = Table::new(2, 1, 200.0);
+        t.props.borders = Some(Borders { top: line, left: line, bottom: line, right: line, between: line, inside_v: line });
+        t.props.cell_margins = Some([5.0, 5.4, 5.0, 5.4]);
+        for (r, text) in t.rows.iter_mut().zip(["one", "two"]) {
+            r.props.height = Some(30.0);
+            r.props.height_rule = HeightRule::AtLeast;
+            r.cells[0].blocks = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, Default::default()))];
+        }
+        d.body = vec![std::sync::Arc::new(wordcraft_doc::Block::Table(t))];
+        let tops = line_tops(&lay(&d));
+        assert!((tops[1] - tops[0] - (40.0 + band)).abs() < 0.01, "{style:?}: row pitch {}", tops[1] - tops[0]);
+        assert!((tops[0] - (72.0 + band + 5.0)).abs() < 0.01, "{style:?}: first cell text at {}", tops[0]);
+    }
+}
+
