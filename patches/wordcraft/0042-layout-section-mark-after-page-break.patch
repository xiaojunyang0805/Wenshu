+/// "Before", a paragraph of only a page break, then an empty paragraph carrying a next-page
+/// section break, then "After": one page after the break, "After" on it (WPS, for files with
+/// compatibility settings). The empty mark took the page the break started, and the section
+/// break began another, blank but for its mark.
+#[test]
+fn an_empty_section_mark_after_a_page_break_makes_no_page() {
+    use wordcraft_doc::section::SectionProps;
+    for bookmark in [false, true] {
+        let mut d = Document::from_text("Before\n\u{000C}\n\nAfter");
+        if bookmark {
+            // A bookmark ending after the break leaves it the last thing shown.
+            d.insert_object(&Pos::body(1, 1), InlineObject::BookmarkEnd { name: "toc".into() }, &Default::default()).unwrap();
+        }
+        d.para_mut(StoryRef::Body, &Path::top(2)).unwrap().section = Some(Box::new(SectionProps::default()));
+        let l = lay(&d);
+        assert_eq!(l.pages.len(), 2, "bookmark {bookmark}");
+        assert_eq!(l.caret(&Pos::body(3, 0)).unwrap().page, 1, "After starts page 2 (bookmark {bookmark})");
+    }
+}
