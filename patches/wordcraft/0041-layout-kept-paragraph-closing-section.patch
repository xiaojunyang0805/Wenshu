+/// The last paragraph of a section before a new page is placed as if keep with next and keep
+/// lines together were unset (measured in WPS, next-page and next-column breaks): there is no next
+/// paragraph on its page to keep with, and an empty one still stays at the bottom of a full page.
+/// A kept closing paragraph (a heading style) moved over, and the break then began another page.
+#[test]
+fn a_kept_paragraph_closing_a_section_leaves_no_empty_page() {
+    use wordcraft_doc::section::SectionProps;
+    let pages = |text: &str, kept: bool, extra: usize| {
+        let lines: Vec<String> = (1..=200).map(|i| format!("Line {i}")).collect();
+        let one_page = lay(&Document::from_text(&lines.join("\n"))).pages[0].items.iter().filter(|i| matches!(i, Placed::Lines { .. })).count();
+        let fill = one_page - extra;
+        let mut d = Document::from_text(&format!("{}\n{text}\nNext", lines[..fill].join("\n")));
+        let mark = d.para_mut(StoryRef::Body, &Path::top(fill)).unwrap();
+        mark.section = Some(Box::new(SectionProps::default()));
+        if kept {
+            mark.props.keep_next = Some(true);
+            mark.props.keep_lines = Some(true);
+        }
+        lay(&d).pages.len()
+    };
+    // Empty, on a full page or with one line of room; with text, with one line of room.
+    for (text, extra) in [("", 0), ("", 1), ("End of the section", 1)] {
+        assert_eq!(pages(text, true, extra), pages(text, false, extra), "{text:?}, {extra} lines of room");
+        assert_eq!(pages(text, true, extra), 2, "{text:?}, {extra} lines of room");
+    }
+}
