+/// A wrap distance written as the unsigned form of −1 (`distT="4294967295"`, common in footer
+/// rules converted from VML) is no distance (WPS Office); a large signed one is still clamped.
+#[test]
+fn unsigned_minus_one_wrap_distance_is_none() {
+    let body = r#"<w:p><w:r><w:drawing><wp:anchor behindDoc="0" distT="4294967295" distB="2147483647" distL="114300" distR="114300"><wp:positionH relativeFrom="margin"><wp:posOffset>0</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>0</wp:posOffset></wp:positionV><wp:extent cx="127000" cy="0"/><wp:wrapTopAndBottom/><wp:docPr id="1" name="L"/><a:graphic><a:graphicData uri="http://schemas.microsoft.com/office/word/2010/wordprocessingShape"><wps:wsp><wps:spPr><a:prstGeom prst="line"/></wps:spPr></wps:wsp></a:graphicData></a:graphic></wp:anchor></w:drawing></w:r></w:p>"#;
+    let d = read_body(body);
+    let p = paras(&d);
+    let Some(InlineObject::Shape { float, .. }) = p[0].objects.first() else { panic!("{:?}", p[0].objects) };
+    assert_eq!((float.dist_top, float.dist_bottom, float.dist), (0.0, 1584.0, 9.0));
+}
