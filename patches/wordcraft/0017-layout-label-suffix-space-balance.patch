+
+/// A list label's suffix space follows `w:balanceSingleByteDoubleByteWidth` too: half an em of
+/// the label's size, where it is a quarter otherwise (WPS Office, `dc-policies-730d6a61a9`: `11.`
+/// then 8 pt before 16 pt text).
+#[test]
+fn balanced_single_byte_width_makes_a_label_s_suffix_space_half_an_em() {
+    let text_x = |balance: bool| {
+        let mut d = Document::new();
+        let mut items = numbered(&mut d, &["text"], ParaProps::default());
+        items[0].props.indent_left = Some(0.0);
+        items[0].props.indent_first = Some(0.0);
+        let id = d.numbering.abstract_of(d.numbering.nums[0].id).map(|a| a.id).unwrap();
+        let a = d.numbering.abstracts.iter_mut().find(|a| a.id == id).unwrap();
+        a.levels[0].suffix = wordcraft_doc::numbering::LevelSuffix::Space;
+        a.levels[0].chr.size = Some(16.0);
+        items[0].runs[0].props.size = Some(16.0);
+        d.body = items.into_iter().map(wordcraft_doc::para_block).collect();
+        d.settings.balance_sbcs_dbcs = balance;
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        let lab = para.label.as_ref().unwrap();
+        para.lines[0].xs[0] - (lab.x + lab.width)
+    };
+    assert!((text_x(true) - 8.0).abs() < 0.01, "half an em: {}", text_x(true));
+    assert!((text_x(false) - 4.0).abs() < 0.01, "a quarter: {}", text_x(false));
+}
