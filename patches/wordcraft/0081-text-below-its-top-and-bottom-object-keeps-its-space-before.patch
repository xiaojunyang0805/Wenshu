+/// Text below its own paragraph's top-and-bottom object starts the paragraph's space before below
+/// it: the object sits at the paragraph's top, above that space, and the text keeps it (WPS, both
+/// modes: 9 pt before puts the text 9 pt under the picture; none, right under it).
+#[test]
+fn text_below_its_top_and_bottom_object_keeps_its_space_before() {
+    crate::test_fonts();
+    use wordcraft_doc::para::{Anchor, Float, Wrap};
+    let tops = |before: f32| {
+        let mut d = Document::from_text(
+            "Previous.
+Text below the picture.",
+        );
+        let f = Float { wrap: Wrap::TopAndBottom, h_rel: Anchor::Column, v_rel: Anchor::Paragraph, ..Default::default() };
+        d.insert_object(&Pos::body(1, 0), rect_shape(200.0, 100.0, f), &Default::default()).unwrap();
+        for b in d.body.iter_mut() {
+            if let Block::Para(p) = Arc::make_mut(b) {
+                p.props.space_before = Some(0.0);
+                p.props.space_after = Some(0.0);
+            }
+        }
+        if let Some(Block::Para(p)) = d.body.get_mut(1).map(Arc::make_mut) {
+            p.props.space_before = Some(before);
+        }
+        let l = lay(&d);
+        let r = shapes(&l.pages[0].items)[0];
+        let text = l.pages[0].items.iter().find_map(|i| match i {
+            Placed::Lines { y, path, story: StoryRef::Body, .. } if path.0.first() == Some(&1) => Some(*y),
+            _ => None,
+        });
+        (r.bottom(), text.expect("the paragraph's text"))
+    };
+    let (bottom, text) = tops(0.0);
+    assert!((text - bottom).abs() < 0.5, "no space before: text at {text}, the picture ends at {bottom}");
+    let (bottom, text) = tops(9.0);
+    assert!((text - bottom - 9.0).abs() < 0.5, "9 pt before: text at {text}, the picture ends at {bottom}");
+}
