+/// Text below its own paragraph's top-and-bottom object starts the paragraph's space before
+/// (`own_before`) below it, also where the top of a page or a cell leaves the space out above it:
+/// the object's area grows by it when it starts at or above the text's top (`text_top`). WPS,
+/// both modes: 9 pt before puts the text 9 pt under the picture, mid-page and at the top.
+pub(crate) fn keep_space_before_below(area: Option<WrapArea>, own_before: f32, text_top: f32) -> Option<WrapArea> {
+    area.map(|mut a| {
+        if a.1 && own_before > 0.0 && own_before.is_finite() && a.0.y <= text_top + 0.5 {
+            a.0.h += own_before.min(1584.0);
+        }
+        a
+    })
+}
