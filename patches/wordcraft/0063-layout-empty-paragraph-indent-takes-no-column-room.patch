 /// A table with its own width keeps it when it is over 1.5 times the text width (#1721); one
 /// without is still squeezed to the margins.
+/// An empty paragraph's indents take no room when a table fits its columns to their contents
+/// (WPS Office: a 270 pt first-line indent on an empty paragraph in a narrow last column left
+/// the grid alone, `dc-policies-1403def07e`; with text in it the column grows).
+#[test]
+fn an_empty_paragraphs_indent_doesnt_widen_its_column() {
+    let widest = |text: &str| {
+        let d = Document::from_text("x");
+        let mut t = Table::new(1, 2, 300.0);
+        let mut p = wordcraft_doc::Paragraph::with_text(text, Default::default());
+        p.props.indent_first = Some(270.0);
+        t.rows[0].cells[1].blocks = vec![wordcraft_doc::para_block(p)];
+        measure_table_columns(&d, &t).get(1).map_or(0.0, |c| c.1)
+    };
+    assert!(widest("") < 40.0, "empty: {}", widest(""));
+    assert!(widest("字") > 270.0, "with text: {}", widest("字"));
+}
