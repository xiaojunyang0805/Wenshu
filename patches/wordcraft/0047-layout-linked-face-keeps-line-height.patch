+/// A CJK compatibility ideograph the run's fonts lack (理 written U+F9E4) is drawn in a face
+/// standing in for them, which adds no height to the line: WPS lays the line out as tall as one
+/// without it (measured with Microsoft JhengHei UI filling in for 宋体). It grew by that face's
+/// own East Asian line height.
+#[test]
+fn a_compatibility_ideograph_keeps_the_line_height() {
+    let height = |text: &str| {
+        let props = CharProps { font: Some("Times New Roman".into()), font_ea: Some("SimSun".into()), ..Default::default() };
+        let mut d = Document::new();
+        d.body = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, props))];
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!("no text") };
+        para.lines[0].height
+    };
+    assert_eq!(height("漢\u{f9e4}漢"), height("漢漢漢"));
+}
