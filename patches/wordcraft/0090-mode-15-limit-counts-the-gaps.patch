+/// Mode 15, justified: the limit counts the gaps between the characters before the line's last
+/// unit, one fewer than the characters (WPS, 宋体 12 pt, N characters with k commas and the last
+/// overflowing, 0.05 pt steps: the most the line squeezed, in ems).
+#[test]
+fn the_mode_15_limit_counts_the_gaps_before_the_last_unit() {
+    let wps = [(24, 2, 0.746), (24, 3, 0.817), (30, 2, 0.700), (36, 2, 0.654), (36, 3, 0.742), (36, 4, 0.792)];
+    for (chars, k, limit) in wps {
+        let before = (chars - 1) as f32 * 12.0;
+        let got = crate::para::justified_squeeze(k as f32, crate::para::justified_n(before, 12.0), 0);
+        assert!((got - limit).abs() <= 0.006, "{chars} characters, {k} marks: {got} em, WPS {limit}");
+    }
+}
