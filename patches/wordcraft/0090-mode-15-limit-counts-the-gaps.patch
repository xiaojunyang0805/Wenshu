+/// The n of [`justified_squeeze`] for a line `before` points long before its last unit, in ems
+/// of `em`: the gaps between those characters, one fewer than the characters (WPS, 12 pt, 24- to
+/// 36-character lines, 2–4 marks, 0.05 pt steps: n came out 1.0–1.6 em under the width).
+pub(crate) fn justified_n(before: f32, em: f32) -> f32 {
+    if before.is_finite() && em > 0.0 { (before / em - 1.0).clamp(0.0, 10_000.0) } else { 0.0 }
+}
