+/// Distributed turned text (a rating scale's "非常不符合" header, `jc="distribute"`): the row is as
+/// long as the text needs, or its at-least height, not the longest turned line allowed (the
+/// spread text measured placed asked for that, and a five-character header filled the page).
+#[test]
+fn distributed_turned_text_keeps_its_own_length() {
+    let row_h = |rule: Option<f32>| {
+        let mut d = turned_table(TextDirection::Down, "非常不符合", None);
+        let Some(Block::Table(t)) = d.body.get_mut(1).map(Arc::make_mut) else { panic!("no table") };
+        if let Some(Block::Para(p)) = t.rows[0].cells[1].blocks.first_mut().map(Arc::make_mut) {
+            p.props.align = Some(Align::Distribute);
+        }
+        if let Some(h) = rule {
+            t.rows[0].props.height = Some(h);
+            t.rows[0].props.height_rule = wordcraft_doc::props::HeightRule::AtLeast;
+        }
+        let l = lay(&d);
+        l.caret(&Pos::body(2, 0)).unwrap().top - l.caret(&Pos::body(0, 0)).unwrap().top
+    };
+    let plain = row_h(None);
+    assert!(plain < 120.0, "about five characters long: {plain}");
+    let least = row_h(Some(150.0));
+    assert!(least > 150.0 && least < 200.0, "at least the row's height: {least}");
+}
