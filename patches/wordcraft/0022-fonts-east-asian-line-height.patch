+    #[test]
+    fn east_asian_faces_take_1_3_times_their_win_height() {
+        // SimSun (256 units: win 220 / 36, GB2312): 1.3 em, the extra 0.3 em split evenly.
+        let (a, d) = east_asian_line(0x0004_0001, 220.0, 36.0, 256.0).unwrap_or_default();
+        assert!(((a + d) / 256.0 - 1.3).abs() < 1e-9 && (a - (220.0 + 0.15 * 256.0)).abs() < 1e-9, "{a} {d}");
+        // Microsoft JhengHei (Big5 only), 1.33 em tall: 1.729 em.
+        let (a, d) = east_asian_line(0x0010_0009, 2179.0, 545.0, 2048.0).unwrap_or_default();
+        assert!(((a + d) / 2048.0 - 1.3 * 2724.0 / 2048.0).abs() < 1e-9);
+        // Latin faces (Times New Roman's code pages) and broken metrics keep the usual line.
+        assert_eq!(east_asian_line(0x4000_01ff, 1825.0, 443.0, 2048.0), None);
+        assert_eq!(east_asian_line(0x0004_0000, 0.0, 36.0, 256.0), None);
+        assert_eq!(east_asian_line(0x0004_0000, 600.0, 36.0, 256.0), None);
+    }
