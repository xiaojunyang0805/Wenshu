+/// The (ascent, descent) a line of text gives this face, in font units. A face made for
+/// Chinese, Japanese or Korean (an OS/2 code page among JIS, GB2312, Wansung, Big5 and Johab)
+/// takes 1.3 times its usWinAscent + usWinDescent, the extra split evenly above and below:
+/// measured in WPS Office for 宋体, 黑体, 楷体, 仿宋 (1.30 em), Microsoft YaHei (1.714 em),
+/// Microsoft JhengHei (1.726 em) and DengXian (1.354 em), at 10.5 to 16 pt, with Latin text
+/// in the face too. Other faces take [`line_metrics`].
+pub fn text_line_metrics(face: &crate::FontFace) -> (f64, f64) {
+    static CACHE: OnceLock<Mutex<HashMap<u32, Option<(f64, f64)>>>> = OnceLock::new();
+    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    let cached = cache.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get(&face.id()).copied();
+    let east_asian = match cached {
+        Some(v) => v,
+        None => {
+            let v = face.skrifa().and_then(|f| f.os2().ok()).and_then(|o| {
+                let pages = o.ul_code_page_range_1().unwrap_or(0);
+                east_asian_line(pages, f64::from(o.us_win_ascent()), f64::from(o.us_win_descent()), face.upem)
+            });
+            cache.lock().unwrap_or_else(std::sync::PoisonError::into_inner).insert(face.id(), v);
+            v
+        }
+    };
+    east_asian.unwrap_or_else(|| line_metrics(face))
+}
+
+/// [`text_line_metrics`] for an East Asian face: `None` for any other, or for win metrics that
+/// are missing or more than twice the em.
+fn east_asian_line(code_pages: u32, win_ascent: f64, win_descent: f64, upem: f64) -> Option<(f64, f64)> {
+    /// OS/2 ulCodePageRange1 bits 17–21: JIS/Japan, Chinese Simplified, Korean Wansung,
+    /// Chinese Traditional, Korean Johab.
+    const EAST_ASIAN: u32 = 0x003E_0000;
+    let total = win_ascent + win_descent;
+    if code_pages & EAST_ASIAN == 0 || win_ascent <= 0.0 || total > upem * 2.0 {
+        return None;
+    }
+    let extra = 0.15 * total;
+    Some((win_ascent + extra, win_descent + extra))
+}
