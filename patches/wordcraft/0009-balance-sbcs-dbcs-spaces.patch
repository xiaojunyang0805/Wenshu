+/// `w:balanceSingleByteDoubleByteWidth` in the settings' `w:compat` (123 of Wenshu's 200 Chinese
+/// corpus documents set it) is read and written back.
+#[test]
+fn balance_single_byte_double_byte_width_is_read_and_kept() {
+    let settings = |compat: &str| {
+        let s = format!(r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:settings {W_NS}><w:compat>{compat}</w:compat></w:settings>"#);
+        let rels = [("rId9", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/settings", "settings.xml")];
+        let d = wordcraft_docx::read(&docx("<w:p/>", &rels, &[("word/settings.xml", &s)])).unwrap();
+        let again = wordcraft_docx::read(&wordcraft_docx::write(&d).unwrap()).unwrap();
+        (d.settings.balance_sbcs_dbcs, again.settings.balance_sbcs_dbcs)
+    };
+    assert_eq!(settings("<w:spaceForUL/><w:balanceSingleByteDoubleByteWidth/><w:doNotExpandShiftReturn/>"), (true, true));
+    assert_eq!(settings(r#"<w:balanceSingleByteDoubleByteWidth w:val="0"/>"#), (false, false));
+    assert_eq!(settings(""), (false, false));
+}
