+/// `w:balanceSingleByteDoubleByteWidth`: each space is half an em of its size, whatever its font;
+/// letters keep their own widths (WPS Office, probe 33 of Wenshu's corpus).
+#[test]
+fn balanced_single_byte_width_makes_spaces_half_an_em() {
+    use wordcraft_doc::props::CharProps;
+    let props = CharProps { size: Some(20.0), font: Some("Times New Roman".into()), ..Default::default() };
+    let widths = |balance: bool| {
+        let mut d = Document::new();
+        let p = wordcraft_doc::Paragraph::with_text("ab          cd", props.clone());
+        d.body = vec![wordcraft_doc::para_block(p)];
+        d.settings.balance_sbcs_dbcs = balance;
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        let of = |kind: crate::para::ClKind| para.clusters.iter().filter(|c| c.kind == kind).map(|c| c.adv).sum::<f32>();
+        (of(crate::para::ClKind::Space), of(crate::para::ClKind::Text))
+    };
+    let (spaces, letters) = widths(true);
+    assert!((spaces - 100.0).abs() < 0.01, "ten 20 pt spaces take 100 pt: {spaces}");
+    let (plain_spaces, plain_letters) = widths(false);
+    assert!(plain_spaces < 60.0, "without the setting a space keeps its font's width: {plain_spaces}");
+    assert!((letters - plain_letters).abs() < 0.01, "letters keep their widths");
+}
