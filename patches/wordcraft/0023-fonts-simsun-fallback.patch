+
+/// Chinese text no loaded font covers falls back to 宋体 before Microsoft YaHei, as WPS Office
+/// draws it on Windows (an empty theme East Asian font, Chinese in a Latin font).
+#[test]
+#[cfg(not(target_arch = "wasm32"))]
+fn chinese_falls_back_to_simsun_before_yahei() {
+    let at = |name: &str| fallback_data::SYSTEM_FALLBACKS.iter().position(|f| *f == name);
+    assert!(at("SimSun").zip(at("Microsoft YaHei")).is_some_and(|(s, y)| s < y));
+}
