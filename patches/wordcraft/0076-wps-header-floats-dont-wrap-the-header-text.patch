+/// F46: in WPS Office's own layout mode a header's floating picture doesn't push the header's text
+/// down (it overlaps the picture, where it is without one), while the body still starts below a
+/// picture that leaves no room beside it; beside a narrower one the body stays at the top margin.
+/// In the other mode (as in Word) the header text wraps below the picture.
+#[test]
+fn wps_header_floats_leave_the_header_text_in_place() {
+    crate::test_fonts();
+    use wordcraft_doc::para::{Anchor, Float, Wrap};
+    // (header text top, body top) for a 96 pt square-wrapped picture `w` wide at the header's top.
+    let tops = |wps: bool, w: Option<f32>| {
+        let mut d = Document::from_text("Body text.");
+        d.settings.wps_layout = wps;
+        d.last_section.header = 0.0;
+        let mut hp = wordcraft_doc::Paragraph::with_text("Header", Default::default());
+        if let Some(w) = w {
+            let f = Float { wrap: Wrap::Square, h_rel: Anchor::Column, v_rel: Anchor::Paragraph, y: 1.0, ..Default::default() };
+            hp.insert_object(0, rect_shape(w, 96.0, f), &Default::default()).unwrap();
+        }
+        let id = d.add_part(wordcraft_doc::PartKind::Header, vec![wordcraft_doc::para_block(hp)]);
+        d.last_section.headers.default = Some(id);
+        let l = lay(&d);
+        let head = l.pages[0].header.iter().find_map(|i| match i {
+            Placed::Lines { y, .. } => Some(*y),
+            _ => None,
+        });
+        (head.expect("header text laid out"), first_line_top(&l.pages[0].items))
+    };
+    let width = Document::new().last_section.text_width();
+    let (plain_head, plain_body) = tops(true, None);
+    let (head, body) = tops(true, Some(width));
+    assert!((head - plain_head).abs() < 0.5, "WPS: header text at {head}, {plain_head} without the picture");
+    assert!((body - 97.0).abs() < 0.5, "WPS: body at {body}, not below the picture (97)");
+    let (_, beside) = tops(true, Some(width / 2.0));
+    assert!((beside - plain_body).abs() < 0.5, "WPS: body at {beside} beside a half-width picture, {plain_body} without");
+    let (head, body) = tops(false, Some(width));
+    assert!(head > 96.0 && body > head, "other mode: header text at {head} below the picture, body at {body}");
+}
