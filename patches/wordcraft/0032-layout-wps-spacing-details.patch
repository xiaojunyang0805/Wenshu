+
+#[test]
+fn a_multiple_spaced_lines_leading_may_run_into_a_tall_footer() {
+    // WPS: with a footer taller than the bottom margin, a double-spaced page's last line stays
+    // while its text clears the footer, its leading reaching into it; its text never does.
+    use wordcraft_doc::props::LineSpacing;
+    let mut d = Document::from_text(&"Body line\n".repeat(60));
+    for b in d.body.iter_mut() {
+        if let wordcraft_doc::Block::Para(p) = Arc::make_mut(b) {
+            p.props.line_spacing = Some(LineSpacing::Multiple(2.0));
+            p.props.space_after = Some(0.0);
+        }
+    }
+    let id = d.add_part(PartKind::Footer, paras("Footer line", 8));
+    d.last_section.footers.default = Some(id);
+    let l = lay(&d);
+    let mut leading_in_footer = false;
+    for (i, p) in l.pages.iter().enumerate().take(l.pages.len().saturating_sub(1)) {
+        let (top, _) = extent(&p.footer, StoryRef::Part(id)).unwrap();
+        let Some(Placed::Lines { y, para, l0, l1, .. }) = p.items.iter().rev().find(|it| matches!(it, Placed::Lines { story: StoryRef::Body, .. }))
+        else {
+            panic!()
+        };
+        let last = &para.lines[*l1 - 1];
+        let line_top = y + last.top - para.lines[*l0].top;
+        let text_end = line_top + (last.baseline - last.top) + last.text_desc;
+        assert!(text_end <= top + 0.01, "page {i}: the text ends at {text_end}, below the footer at {top}");
+        leading_in_footer |= line_top + last.height > top + 0.01;
+    }
+    assert!(leading_in_footer, "some page's last line has its leading in the footer");
+}
