+/// A paragraph opening with a column break takes no room in the column it leaves: the break's
+/// line, however large, doesn't make that column end lower (WPS, both modes: the next continuous
+/// section starts below the text of the taller column, not below the break).
+#[test]
+fn a_leading_column_break_takes_no_room_in_the_column_it_leaves() {
+    crate::test_fonts();
+    use wordcraft_doc::section::SectionStart;
+    let next_section_top = |break_size: f32| {
+        let mut d = two_column_section(SectionStart::Continuous, vec![]);
+        let brk = wordcraft_doc::para::COLUMN_BREAK.to_string();
+        d.para_mut(StoryRef::Body, &Path::top(5)).unwrap().insert_text(0, &brk, &Default::default()).unwrap();
+        d.format_range(&Pos::body(5, 0), &Pos::body(5, brk.len()), &|c| c.size = Some(break_size)).unwrap();
+        let l = lay(&d);
+        let b = para_boxes(&l);
+        (b[10].0, b[10].2)
+    };
+    let (small, large) = (next_section_top(11.0), next_section_top(60.0));
+    assert_eq!((small.0, large.0), (0, 0), "the next section stays on page 1");
+    assert!((small.1 - large.1).abs() < 0.01, "next section below a 60 pt break at {}, an 11 pt one at {}", large.1, small.1);
+}
