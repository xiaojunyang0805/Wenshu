+
+/// Multiple spacing on a line grid takes the line's whole pitches or `m` pitches, whichever is
+/// more (WPS): large text keeps its pitches at 1.5 spacing, small text at 2.5 spacing takes 2.5.
+#[test]
+fn multiple_spacing_on_a_line_grid_takes_the_larger_of_the_pitches_and_m_pitches() {
+    let height = |size: f32, m: f32| {
+        let mut d = with_grid("Grid line", DocGridType::Lines, 0);
+        for b in d.body.iter_mut() {
+            if let Block::Para(p) = std::sync::Arc::make_mut(b) {
+                p.props.line_spacing = Some(LineSpacing::Multiple(m));
+                for r in p.runs.iter_mut() {
+                    r.props.size = Some(size);
+                }
+            }
+        }
+        lines(&lay(&d)).1[0]
+    };
+    let big = height(30.0, 1.0);
+    assert!(big >= 36.0 - 1e-3, "30 pt text takes at least two 18 pt pitches ({big})");
+    assert!((height(30.0, 1.5) - big).abs() < 1e-3, "1.5 × 18 is less than its pitches: unchanged");
+    assert!((height(10.0, 2.5) - 45.0).abs() < 1e-3, "small text at 2.5 spacing takes 2.5 pitches ({})", height(10.0, 2.5));
+}
