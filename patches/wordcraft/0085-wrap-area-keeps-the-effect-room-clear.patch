+/// The room a file keeps for effects around an object (`wp:effectExtent`) is part of what text
+/// keeps clear of (WPS, measured: a square-wrapped picture with 1.5, 10 and 20 pt effect room on
+/// its left moves the text beside it that much further left; none leaves it at the distance).
+#[test]
+fn wrap_area_keeps_the_effect_room_clear() {
+    crate::test_fonts();
+    use wordcraft_doc::para::{Float, Wrap};
+    let f = Float { wrap: Wrap::Square, dist: 9.0, effect: [1.5, 2.0, 0.0, 4.0], ..Default::default() };
+    let (r, ..) = wrap_area(Rect::new(10.0, 20.0, 100.0, 50.0), &f, None).unwrap();
+    assert_eq!((r.x, r.y, r.right(), r.bottom()), (-0.5, 18.0, 119.0, 74.0));
+    let hostile = Float { wrap: Wrap::Square, effect: [f32::NAN, -5.0, f32::INFINITY, 0.0], ..Default::default() };
+    let (r, ..) = wrap_area(Rect::new(0.0, 0.0, 10.0, 10.0), &hostile, None).unwrap();
+    assert!(r.w.is_finite() && r.x == 0.0 && r.y == 0.0, "{r:?}");
+}
+
 /// Text below its own paragraph's top-and-bottom object starts the paragraph's space before below
 /// it: the object sits at the paragraph's top, above that space, and the text keeps it (WPS, both
 /// modes: 9 pt before puts the text 9 pt under the picture; none, right under it).
