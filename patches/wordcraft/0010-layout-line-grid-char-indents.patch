+#[test]
+fn character_indents_on_a_line_grid_count_the_default_size_at_the_sides() {
+    // A line grid has no character pitch: the left and right indents count the Normal style's
+    // size (the grid's default), the first-line indent the paragraph mark's (WPS Office).
+    let d = with_grid(&"中".repeat(200), DocGridType::Lines, 0);
+    let normal = para::Grid::of(&d, &d.last_section).font_size;
+    let mark = normal + 6.0;
+    let with = |f: &dyn Fn(&mut wordcraft_doc::Paragraph)| {
+        let mut d = d.clone();
+        if let Some(Block::Para(p)) = d.body.first_mut().map(std::sync::Arc::make_mut) {
+            p.mark.size = Some(mark);
+            f(p);
+        }
+        first_para(&lay(&d))
+    };
+    let base = with(&|_| {});
+    let left = with(&|p| p.props.indent_left_chars = Some(2.0));
+    assert!((left.lines[1].left - base.lines[1].left - 2.0 * normal).abs() < 0.01, "left {}", left.lines[1].left);
+    let right = with(&|p| p.props.indent_right_chars = Some(2.0));
+    assert!((base.lines[1].right - right.lines[1].right - 2.0 * normal).abs() < 0.01, "right {}", right.lines[1].right);
+    let first = with(&|p| p.props.indent_first_chars = Some(2.0));
+    let indent = first.lines[0].xs[0] - first.lines[1].xs[0];
+    assert!((indent - 2.0 * mark).abs() < 0.01, "first-line indent {indent} for a {mark} pt mark");
+}
