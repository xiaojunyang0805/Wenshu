+/// `w:line="0" w:lineRule="atLeast"` is no rule to WPS: on a line grid the line keeps its natural
+/// height, as with snapping off; any other minimum, 0.05 pt included, snaps (measured: 14 pt text
+/// on an 18 pt grid, 18.24 pt lines at 0, 36 at 0.05 to 20 pt).
+#[test]
+fn at_least_zero_lines_are_off_the_grid() {
+    let text = ["Grid line"; 6].join("\n");
+    let heights = |spacing: LineSpacing, snap: bool| {
+        let mut d = with_grid(&text, DocGridType::Lines, 0);
+        for b in d.body.iter_mut() {
+            if let Block::Para(p) = std::sync::Arc::make_mut(b) {
+                p.props.line_spacing = Some(spacing);
+                p.props.snap_to_grid = Some(snap);
+            }
+        }
+        lines(&lay(&d)).1
+    };
+    assert_eq!(heights(LineSpacing::AtLeast(0.0), true), heights(LineSpacing::AtLeast(0.0), false), "natural height, off the grid");
+    let snapped = heights(LineSpacing::AtLeast(0.05), true);
+    assert!(snapped.iter().all(|h| ((h / 18.0) - (h / 18.0).round()).abs() < 1e-3), "{snapped:?}");
+}
