diff --git a/crates/layout/src/tests/grid.rs b/crates/layout/src/tests/grid.rs
--- a/crates/layout/src/tests/grid.rs
+++ b/crates/layout/src/tests/grid.rs
@@ -354,6 +354,37 @@ fn character_indents_on_a_character_grid_count_the_texts_advance() {
 
 /// On a character grid the column is as wide as the most whole pitches it holds (WPS Office,
 /// `gov-nmpa-6`); a width a whole number of pitches keeps it, and so does a section without one.
+/// Punctuation compression on a character grid: a line one cell too long fits by squeezing its
+/// marks by up to half a cell each, not half the font size, and with no shorter limit for a
+/// longer line, in compatibility mode 15 too (WPS: `題：一、董事會如何組成？` on a 17 pt pitch at
+/// 16 pt squeezes `：` and `、` 8.5 pt each).
+#[test]
+fn a_character_grid_line_squeezes_its_marks_by_half_a_cell() {
+    crate::test_fonts();
+    let lines = wordcraft_doc::SectionProps { doc_grid: Some(DocGrid { kind: DocGridType::Lines, ..Default::default() }), ..Default::default() };
+    let size = para::Grid::of(&Document::from_text(""), &lines).font_size;
+    let cs = DocGrid::char_space_for(size + 2.5, size);
+    let probe = with_grid("日", DocGridType::LinesAndChars, cs);
+    let pitch = probe.last_section.grid_char_pitch(size).unwrap();
+    let first = |d: &Document| {
+        lay(d).pages[0].items.iter().find_map(|it| if let Placed::Lines { para, .. } = it { Some(para.clone()) } else { None }).unwrap()
+    };
+    let cells = (first(&probe).lines[0].right / pitch).round() as usize;
+    // One cell more than the line holds, two of them marks, ending in a unit that can't be split
+    // (`成？`) as in WPS's line.
+    let text = format!("{}：一、成？", "日".repeat(cells - 4));
+    let mut d = with_grid(&text, DocGridType::LinesAndChars, cs);
+    d.settings.compat_mode = 15;
+    d.settings.char_spacing = wordcraft_doc::CharSpacing::CompressPunctuation;
+    for b in d.body.iter_mut() {
+        if let Block::Para(p) = std::sync::Arc::make_mut(b) {
+            p.props.align = Some(wordcraft_doc::props::Align::Justify);
+        }
+    }
+    let pl = first(&d);
+    assert_eq!(pl.lines.len(), 1, "{} cells on a {cells}-cell line of {pitch} pt", cells + 1);
+}
