+/// Fonts an app ships (a browser build's, fetched from its server) are found by name in every
+/// document, redraw layouts, and aren't the user's: a file that doesn't decode is skipped.
+#[test]
+fn app_fonts_are_shared_and_redraw_layouts() {
+    let db = FontDb::with_font_dirs(Vec::new());
+    db.set_system_fallback(false);
+    let generation = db.generation();
+    let file = with_family_names("SourceSans3-Regular.ttf", &[(0x0409, "Shipped Test")]);
+    assert_eq!(db.add_app_fonts(vec![b"not a font".to_vec(), file.clone()]), 1);
+    assert!(db.has_family("Shipped Test"));
+    assert_ne!(db.generation(), generation, "layouts redraw");
+    assert!(db.user_fonts().is_empty(), "not a user font");
+    let generation = db.generation();
+    assert_eq!(db.add_app_fonts(vec![file]), 0, "already there");
+    assert_eq!(db.generation(), generation);
+}
