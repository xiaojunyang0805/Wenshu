+//! WordCraft in the browser, as a library: `main.rs` runs it with WordCraft's [`WebConfig`], and an
+//! app built on WordCraft runs it with its own name and start-up code ([`start`]).
+//!
+//! Runs the same [`wordcraft_ui_egui::WordApp`] as the desktop app through eframe's web runner
+//! (wgpu: WebGPU where available, WebGL2 otherwise). Build with `trunk build --release` from this
+//! directory (output in `dist/web`).
+//!
+//! Differences from the desktop app: no TCP control channel; Open and Insert › Pictures use the
+//! browser file picker (bytes arrive through `Services::inbox`); Save and Export download.
+//! Preferences (theme, interface size, editing options…) are kept in `localStorage` (`prefs`).
+//! URL flags: `?webgl` forces WebGL2; `?sample` opens the sample document.
+//! `?host=parent` (inside an `<iframe>`) talks to a same-origin parent page instead: it sends the
+//! document to open and stores what WordCraft saves (`host`). A page can also host WordCraft in
+//! its own document (no iframe) with `data-host="page"` on the canvas, talking over DOM
+//! `CustomEvent`s on the canvas. `&author=` names the user for comments and tracked changes in
+//! either host mode.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+#[cfg(any(target_arch = "wasm32", test))]
+mod prefs;
+#[cfg(any(target_arch = "wasm32", test))]
+mod save_fallback;
+
+#[cfg(target_arch = "wasm32")]
+mod api;
+#[cfg(target_arch = "wasm32")]
+mod host;
+#[cfg(target_arch = "wasm32")]
+mod web;
+
+pub use wordcraft_ui_egui::AppTool;
+pub use wordcraft_ui_egui::brand::Brand;
+
+/// What an app built on WordCraft's browser front end sets: its name, version and About text
+/// ([`Brand`]), code to run before the app starts (an app installs its font substitutes there,
+/// say), tools it adds to the ribbon, and code to run once the app is up with its egui context
+/// (an app fetches fonts there and repaints when they arrive). [`Default`] is WordCraft's.
+#[derive(Clone, Copy, Debug)]
+pub struct WebConfig {
+    /// The product: the About box, the start-up error.
+    pub brand: Brand,
+    /// Runs before the app is made.
+    pub on_start: Option<fn()>,
+    /// Tools the app adds to the ribbon (Review, in a group named after the brand).
+    pub app_tools: Option<fn() -> Vec<AppTool>>,
+    /// Runs once the app is made, with its context (repaint it after changing fonts: the app lays
+    /// out again when they change).
+    pub on_ready: Option<fn(egui::Context)>,
+}
+
+impl Default for WebConfig {
+    fn default() -> WebConfig {
+        WebConfig { brand: Brand::default(), on_start: None, app_tools: None, on_ready: None }
+    }
+}
+
+/// Start the app in the page's canvas (`<canvas id="wordcraft_canvas">`), as `config` says.
+#[cfg(target_arch = "wasm32")]
+pub fn start(config: WebConfig) {
+    web::start(config);
+}
