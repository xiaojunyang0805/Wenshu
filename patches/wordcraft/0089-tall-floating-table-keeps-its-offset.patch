+/// A floating table placed relative to the text keeps its offset below it when it is too tall for
+/// a page and runs across pages in the text (WPS: `w:tblpY="53"` puts it 2.65 pt lower).
+#[test]
+fn a_floating_table_taller_than_a_page_keeps_its_offset_below_the_text() {
+    crate::test_fonts();
+    use wordcraft_doc::para::Anchor;
+    use wordcraft_doc::props::TableFloat;
+    let first_row = |y: f32| {
+        let mut d = Document::from_text("Before the table.
+After the table.");
+        let mut t = Table::new(80, 1, 300.0);
+        for (i, r) in t.rows.iter_mut().enumerate() {
+            r.cells[0].blocks = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(&format!("Row {i}"), Default::default()))];
+        }
+        t.props.float = Some(TableFloat { h_rel: Anchor::Margin, v_rel: Anchor::Paragraph, y, overlap: false, ..Default::default() });
+        d.insert_block(StoryRef::Body, &Path::top(1), wordcraft_doc::Block::Table(t)).unwrap();
+        let l = lay(&d);
+        assert!(l.pages.len() >= 2, "{} page(s)", l.pages.len());
+        l.pages[0]
+            .items
+            .iter()
+            .find_map(|it| if let Placed::Lines { y, story: StoryRef::Body, path, .. } = it { (path.0.len() > 1).then_some(*y) } else { None })
+            .unwrap()
+    };
+    let (flush, lower) = (first_row(0.0), first_row(2.65));
+    assert!((lower - flush - 2.65).abs() < 0.01, "first row at {lower}, {flush} without the offset");
+}
