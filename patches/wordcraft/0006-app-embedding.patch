+/// What an app built on WordCraft's desktop front end sets: its name, version and About text
+/// ([`Brand`]), its application id and window icon, and code to run before anything else (an app
+/// installs its font substitutes there, say). [`Default`] is WordCraft's.
+#[derive(Clone, Copy, Debug)]
+pub struct AppConfig {
+    /// The product: window titles, the About box, the log.
+    pub brand: Brand,
+    /// The executable's name, as `--version` and command-line errors give it.
+    pub bin: &'static str,
+    /// The settings folder's name (preferences, logs, recovery, personal templates):
+    /// `WordCraft`, or the embedding app's own so the two don't share settings.
+    pub settings_folder: &'static str,
+    /// The application id (Wayland app id, X11 class).
+    pub app_id: &'static str,
+    /// The window and taskbar icon, PNG; `None` for WordCraft's.
+    pub icon_png: Option<&'static [u8]>,
+    /// Runs once logging is installed, before the command line is read and the window opens.
+    pub on_start: Option<fn()>,
+    /// Check for WordCraft updates at start-up (Help › Check for Updates stays available). An app
+    /// with releases of its own turns this off.
+    pub check_updates: bool,
+    /// Tools the app adds to the ribbon (Review, in a group named after the brand).
+    pub app_tools: Option<fn() -> Vec<AppTool>>,
+}
+
+impl Default for AppConfig {
+    fn default() -> AppConfig {
+        AppConfig {
+            brand: Brand::default(),
+            bin: "wordcraft",
+            settings_folder: "WordCraft",
+            app_id: "ai.storyteller.wordcraft",
+            icon_png: None,
+            on_start: None,
+            check_updates: true,
+            app_tools: None,
+        }
+    }
+}
