@@ -385,3 +385,37 @@ fn table_cells_snap_to_the_line_grid_only_when_adjusted() {
     d.settings.adjust_line_height_in_table = true;
     assert!((height(&d, true) - body).abs() < 1e-3, "adjusted, the cell's line snaps like the body's");
 }
+
+/// A single-spaced line on a line grid has its text centred in whole pitches, and the pitch
+/// below the text may run into the bottom margin, as multiple spacing's leading does (WPS,
+/// `gov-mct-keji`): on every page the last line's text ends within the margin, the next line's
+/// would not, and for some shifts the last line's pitches reach past the margin.
+#[test]
+fn a_grid_lines_pitch_below_its_text_may_run_into_the_bottom_margin() {
+    let mut past_margin = 0;
+    for shift in (0..18).step_by(2) {
+        let mut d = with_grid(&"Several words wrap onto many lines of a long paragraph. ".repeat(60), DocGridType::Lines, 0);
+        if let Some(Block::Para(p)) = d.body.get_mut(0).map(std::sync::Arc::make_mut) {
+            p.props.space_before = Some(shift as f32);
+            p.props.widow_control = Some(false);
+        }
+        let bottom = d.last_section.page_h - d.last_section.margin_bottom;
+        let l = lay(&d);
+        assert!(l.pages.len() >= 2, "shift {shift}: the paragraph should run onto a second page");
+        let Some(Placed::Lines { y, para, l0, l1, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { story: StoryRef::Body, .. }))
+        else {
+            panic!("shift {shift}: no body lines on page 1")
+        };
+        let (first, last, next) = (&para.lines[*l0], &para.lines[*l1 - 1], &para.lines[*l1]);
+        assert!(last.height > (last.baseline - last.top) + last.text_desc + 0.5, "shift {shift}: the grid leaves room below the text");
+        let top = y + last.top - first.top;
+        let text_end = top + (last.baseline - last.top) + last.text_desc;
+        assert!(text_end <= bottom + 0.01, "shift {shift}: the last line's text ends at {text_end}, below the margin at {bottom}");
+        let next_text_end = top + last.height + (next.baseline - next.top) + next.text_desc;
+        assert!(next_text_end > bottom + 0.01, "shift {shift}: the next line's text would end at {next_text_end}, within the margin at {bottom}");
+        if top + last.height > bottom + 0.01 {
+            past_margin += 1;
+        }
+    }
+    assert!(past_margin > 0, "some shift should leave the last line's pitch past the margin");
+}
