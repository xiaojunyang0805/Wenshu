+/// Does text asking for `family` (not installed, drawn in a substitute) take the widths of a
+/// Windows Chinese system face? 宋体, 黑体, 仿宋, 楷体 (and their _GB2312 and 新宋体 forms) and
+/// 標楷體 give every character half an em or a whole one (measured: SimSun, SimHei, FangSong and
+/// KaiTi have no other advance), where open substitutes are proportional (朱雀仿宋's `m` is
+/// 0.83 em, its “ 0.33 em), so lines broke elsewhere than in WPS on Windows. `Some` gives the
+/// face's pinyin vowels' advance (ā, é…): half an em in SimSun and SimHei, a whole one in
+/// FangSong and KaiTi (measured), for [`fixed_pitch_advance`].
+pub fn fixed_pitch_standin(family: &str, resolved: &Resolved) -> Option<f32> {
+    if !resolved.substituted {
+        return None;
+    }
+    match family.trim().to_lowercase().as_str() {
+        "宋体" | "simsun" | "新宋体" | "nsimsun" | "黑体" | "simhei" | "標楷體" | "标楷体" | "dfkai-sb" | "dfkai" => Some(0.5),
+        "仿宋" | "fangsong" | "仿宋_gb2312" | "fangsong_gb2312" | "楷体" | "kaiti" | "楷体_gb2312" | "kaiti_gb2312" => Some(1.0),
+        // A missing font the application draws as one of those faces.
+        _ => match provided(family).and_then(|l| l.first()).copied() {
+            Some("SimSun" | "SimHei") => Some(0.5),
+            Some("KaiTi" | "FangSong") => Some(1.0),
+            _ => None,
+        },
+    }
+}
