+/// The pinyin width ([`wordcraft_fonts::word::fixed_pitch_standin`]) when a segment's text stands
+/// in for a Windows Chinese system face (宋体, 仿宋… not installed): that face's widths, half an
+/// em or a whole one a character. The run's own font when the segment is drawn in it, its East
+/// Asian font when in that; a fallback face drawing what the substitute lacks (①, ㎡ beside
+/// 朱雀仿宋) takes them too, as the Windows face has those characters, and Chinese a fallback face
+/// draws where SimSun (its face on Windows) is missing takes SimSun's.
+fn fixed_pitch_of(
+    key: &SegKey,
+    primary_ea: Option<FaceRef>,
+    (family, resolved): (&str, &wordcraft_fonts::word::Resolved),
+    wanted_ea: Option<&(&str, wordcraft_fonts::word::Resolved)>,
+    fallback_chinese: bool,
+) -> Option<f32> {
+    let ea = || wanted_ea.and_then(|(f, r)| wordcraft_fonts::word::fixed_pitch_standin(f, r));
+    let own = || wordcraft_fonts::word::fixed_pitch_standin(family, resolved);
+    if key.complex {
+        None
+    } else if key.face.is_none() {
+        own()
+    } else if key.face.zip(primary_ea).is_some_and(|(f, e)| f.id() == e.id()) {
+        ea()
+    } else {
+        let simsun = (fallback_chinese && wordcraft_fonts::word::chinese_fallback_line().is_some()).then_some(0.5);
+        ea().or_else(own).or(simsun)
+    }
+}
