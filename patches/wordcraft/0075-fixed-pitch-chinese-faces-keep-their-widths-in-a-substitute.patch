+//! Text in a Windows Chinese system face that isn't installed (宋体, 仿宋…) takes that face's
+//! widths in its substitute: half an em for ASCII, a whole one for CJK and curly quotes, as WPS on
+//! Windows lays it out (the open substitutes are proportional).
+
+use crate::{Document, LayoutCache, LayoutOptions, Placed, layout};
+
+/// The widths of the first line's characters of `text` set in `font` at 12 pt.
+fn advances(text: &str, font: &str) -> Vec<f32> {
+    crate::test_fonts();
+    let chr = wordcraft_doc::CharProps { font: Some(font.into()), size: Some(12.0), ..Default::default() };
+    let mut d = Document::new();
+    d.body = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, chr))];
+    let mut c = LayoutCache::new();
+    let l = layout(&d, &mut c, &LayoutOptions::default());
+    for p in &l.pages {
+        for it in &p.items {
+            if let Placed::Lines { para, .. } = it {
+                return para.lines[0].xs.windows(2).map(|w| w[1] - w[0]).collect();
+            }
+        }
+    }
+    panic!("paragraph not laid out");
+}
+
+#[test]
+fn a_missing_fixed_pitch_chinese_face_keeps_its_widths() {
+    crate::test_fonts();
+    for font in ["宋体", "仿宋_GB2312"] {
+        assert!(wordcraft_fonts::word::resolve(font, false, false).substituted, "{font} isn't among the test fonts");
+        let w = advances("mi.1“中”", font);
+        for (i, (got, want)) in w.iter().zip([6.0, 6.0, 6.0, 6.0, 12.0, 12.0, 12.0]).enumerate() {
+            assert!((got - want).abs() < 0.01, "{font}: character {i} is {got} pt, not {want}: {w:?}");
+        }
+    }
+    // Pinyin vowels: half an em in SimSun, a whole one in FangSong.
+    assert!((advances("é", "宋体")[0] - 6.0).abs() < 0.01);
+    assert!((advances("é", "仿宋")[0] - 12.0).abs() < 0.01);
+    // A proportional font keeps its own widths.
+    let w = advances("mi", "Inter");
+    assert!(w[0] > w[1] + 2.0, "Inter's m is wider than its i: {w:?}");
+}
