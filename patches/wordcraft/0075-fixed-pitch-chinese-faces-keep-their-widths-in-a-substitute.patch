+/// The advance in ems a Windows Chinese system face gives `c` ([`fixed_pitch_standin`]): half an
+/// em for ASCII and halfwidth forms, a whole one for CJK, fullwidth forms and the symbols GBK
+/// encodes as double-byte (Unicode's East Asian Ambiguous ones: curly quotes, dashes, ellipsis,
+/// °, ±, ×, pinyin vowels, Greek, Cyrillic). `None` for what such a face lacks: Windows draws
+/// that in another font, at that font's width. `pinyin` is the pinyin vowels' advance, from
+/// [`fixed_pitch_standin`].
+pub fn fixed_pitch_advance(c: char, pinyin: f32) -> Option<f32> {
+    /// Pinyin vowels (à á è é ê ì í ò ó ù ú ü ā ē ě ī ń ň ō ū ǎ ǐ ǒ ǔ ǖ ǘ ǚ ǜ).
+    const PINYIN: &[u32] = &[
+        0xE0, 0xE1, 0xE8, 0xE9, 0xEA, 0xEC, 0xED, 0xF2, 0xF3, 0xF9, 0xFA, 0xFC, 0x101, 0x113, 0x11B, 0x12B, 0x144, 0x148, 0x14D, 0x16B, 0x1CE, 0x1D0,
+        0x1D2, 0x1D4, 0x1D6, 0x1D8, 0x1DA, 0x1DC,
+    ];
+    /// Single double-byte symbols below the CJK blocks: ¤ § ¨ ° ± · × ÷ Ё ё – — ― ‖ ‘ ’ “ ” ‥ … ‰ ′ ″ ※.
+    const WIDE: &[u32] = &[
+        0xA4, 0xA7, 0xA8, 0xB0, 0xB1, 0xB7, 0xD7, 0xF7, 0x401, 0x451, 0x2013, 0x2014, 0x2015, 0x2016, 0x2018, 0x2019, 0x201C, 0x201D, 0x2025, 0x2026,
+        0x2030, 0x2032, 0x2033, 0x203B,
+    ];
+    let u = c as u32;
+    if PINYIN.binary_search(&u).is_ok() {
+        return Some(pinyin);
+    }
+    let wide = WIDE.binary_search(&u).is_ok()
+        // Greek, Cyrillic, symbols (℃, ①, arrows, box drawing), CJK, Hangul, compatibility
+        // ideographs, vertical and fullwidth forms, the supplementary ideographs.
+        || matches!(u, 0x391..=0x3A9 | 0x3B1..=0x3C9 | 0x410..=0x44F | 0x2100..=0x2BFF | 0x2E80..=0x9FFF | 0xAC00..=0xD7A3)
+        || matches!(u, 0xF900..=0xFAFF | 0xFE30..=0xFE4F | 0xFF01..=0xFF60 | 0xFFE0..=0xFFE6 | 0x20000..=0x3FFFF);
+    if wide {
+        Some(1.0)
+    } else if matches!(u, 0x20..=0x7E | 0xFF61..=0xFFDC | 0xFFE8..=0xFFEE) {
+        Some(0.5)
+    } else {
+        None
+    }
+}
