+    /// The advance of `ch` (drawn `natural` wide at `em` points an em) standing in for a fixed-pitch
+    /// Windows face ([`wordcraft_fonts::word::fixed_pitch_standin`], `pinyin` its pinyin vowels'
+    /// width): that face's half or whole em, the glyphs `g0..g1` centred in it (an opening quote at
+    /// its end, a closing one at its start, as those faces draw them). Characters the face lacks
+    /// keep their own advance.
+    fn fixed_pitch_cell(&mut self, ch: char, pinyin: f32, natural: f32, em: f32, (g0, g1): (u32, u32)) -> f32 {
+        let Some(cell) = wordcraft_fonts::word::fixed_pitch_advance(ch, pinyin).map(|w| w * em).filter(|_| natural > 0.0) else {
+            return natural;
+        };
+        let shift = match ch {
+            '\u{2018}' | '\u{201C}' => cell - natural,
+            '\u{2019}' | '\u{201D}' => 0.0,
+            _ => (cell - natural) / 2.0,
+        };
+        for g in self.glyphs.get_mut(g0 as usize..g1 as usize).unwrap_or(&mut []) {
+            g.dx += shift;
+        }
+        cell
+    }
