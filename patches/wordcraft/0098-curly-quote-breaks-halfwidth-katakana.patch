+/// Halfwidth katakana is East Asian for the curly-quote breaks as for kinsoku: `漢|“ｶﾅ”|漢` breaks
+/// before the opening quote and after the closing one.
+#[test]
+fn curly_quotes_beside_halfwidth_katakana_are_break_opportunities() {
+    for text in ["漢“ｶﾅ”漢", "ｶ“漢字”ﾅ"] {
+        let d = Document::from_text(text);
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        let breaks_after = |at: usize| para.clusters.iter().find(|c| c.start <= at && at < c.end).map(|c| c.break_after).unwrap();
+        let open = text.find('“').unwrap();
+        let close = text.find('”').unwrap();
+        let last_before = text[..open].char_indices().next_back().unwrap().0;
+        assert!(breaks_after(last_before), "{text}: a break before “");
+        assert!(breaks_after(close), "{text}: a break after ”");
+    }
+}
