+/// On a character grid WPS Office lays text out in whole cells: a section's single column is as
+/// wide as the most character pitches it holds, its left edge where it was (`gov-nmpa-6`: a
+/// 442.2 pt text width on a 16 pt pitch takes 27 pitches, 432 pt; indents come off that). A width
+/// within a hundredth of a pitch of a whole number keeps it, as the 公文 grid's 28 × 15.79 pt.
+/// Several columns are left as they are.
+pub(crate) fn grid_columns(mut cols: Vec<(f32, f32)>, pitch: Option<f32>) -> Vec<(f32, f32)> {
+    if let (Some(p), [(_, w)]) = (pitch.filter(|p| p.is_finite() && *p > 0.0), cols.as_mut_slice())
+        && w.is_finite()
+    {
+        let n = (*w / p + 0.01).floor().max(1.0);
+        *w = (n * p).min(*w);
+    }
+    cols
+}
