+
+/// On a character grid the column is as wide as the most whole pitches it holds (WPS Office,
+/// `gov-nmpa-6`); a width a whole number of pitches keeps it, and so does a section without one.
+#[test]
+fn a_character_grid_narrows_the_column_to_whole_pitches() {
+    let right = |d: &Document| {
+        let l = lay(d);
+        l.pages[0].items.iter().find_map(|it| if let Placed::Lines { para, .. } = it { Some(para.lines[0].right) } else { None }).unwrap()
+    };
+    let plain = Document::from_text("x");
+    let full = right(&plain);
+    let pitch = |d: &Document| d.last_section.grid_char_pitch(d.styles.resolve_char(Some("Normal"), &Default::default()).size).unwrap();
+    // A pitch that leaves part of a cell over: the default size plus 0.37 pt.
+    let mut d = with_grid("x", DocGridType::LinesAndChars, 1515);
+    let p = pitch(&d);
+    let cells = full / p;
+    assert!((cells - cells.round()).abs() > 0.05, "{cells} cells");
+    assert!((right(&d) - cells.floor() * p).abs() < 0.01, "{} vs {} cells of {p}", right(&d), cells.floor());
+    // A pitch that divides the width exactly (to within a hundredth of a cell) keeps it.
+    let size = d.styles.resolve_char(Some("Normal"), &Default::default()).size;
+    let n = (full / size).floor();
+    d.last_section.doc_grid =
+        Some(DocGrid { kind: DocGridType::LinesAndChars, line_pitch: 18.0, char_space: ((full / n - size) * 4096.0 + 2.0) as i32 });
+    let exact = pitch(&d);
+    assert!((full / exact - n).abs() < 0.01, "{} cells", full / exact);
+    assert!((right(&d) - full).abs() < 0.01, "{} vs {full}", right(&d));
+    // A line grid alone changes nothing.
+    assert!((right(&with_grid("x", DocGridType::Lines, 0)) - full).abs() < 0.01);
+}
