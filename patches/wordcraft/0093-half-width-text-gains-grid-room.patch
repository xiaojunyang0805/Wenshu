+/// The room a half-width character (digits, Latin letters) gains on a character grid when not
+/// everything snaps: the grid's adjustment (the pitch less the default size), or half of it under
+/// `balanceSingleByteDoubleByteWidth`, whatever its font and size (WPS, both modes: on a 17 pt
+/// grid for 16 pt a 宋体 digit advances 9 pt, 8.5 pt balanced; on 18 pt 10 and 9; 12 pt digits and
+/// Times letters gain the same; F58). Nothing without a character grid.
+pub(crate) fn half_width_room(grid: &Grid, balance: bool) -> f32 {
+    let Some(pitch) = grid.chars else { return 0.0 };
+    let adj = (pitch - grid.font_size) * if balance { 0.5 } else { 1.0 };
+    if adj.is_finite() { adj.clamp(-100.0, 100.0) } else { 0.0 }
+}
