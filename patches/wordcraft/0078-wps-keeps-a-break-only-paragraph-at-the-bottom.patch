+/// In WPS Office's own layout mode a paragraph of only a page break that doesn't fit at a page's
+/// bottom stays there, as in Word, and the text after it starts the next page (WPS probes: 24 lines
+/// of exactly 28 pt, the break, then text: 2 pages in its own mode, 3 in the other).
+#[test]
+fn wps_keeps_a_paragraph_of_only_a_page_break_at_the_bottom() {
+    let pages = |fillers: usize, wps: bool| {
+        let plain = ParaProps {
+            space_before: Some(0.0),
+            space_after: Some(0.0),
+            line_spacing: Some(wordcraft_doc::props::LineSpacing::Exactly(28.0)),
+            ..Default::default()
+        };
+        let para = |text: &str| {
+            let mut x = wordcraft_doc::Paragraph::with_text(text, Default::default());
+            x.props = plain.clone();
+            wordcraft_doc::para_block(x)
+        };
+        let mut d = Document::new();
+        d.settings.wps_layout = wps;
+        d.body = (0..fillers).map(|i| para(&format!("F{i}"))).collect();
+        d.body.push(para(&wordcraft_doc::para::PAGE_BREAK.to_string()));
+        d.body.push(para("Text"));
+        lay(&d).pages.len()
+    };
+    let full = (10..80).find(|n| pages(*n + 1, false) == 3 && pages(*n, false) == 3).expect("a filler count that fills page 1");
+    assert_eq!(pages(full, false), 3, "other mode: the break goes over");
+    assert_eq!(pages(full, true), 2, "WPS's own mode: it stays at the bottom");
+}
