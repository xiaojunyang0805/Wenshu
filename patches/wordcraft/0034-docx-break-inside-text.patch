+/// A line break or tab inside a text element (`<w:t>苏州-合肥<w:br/></w:t>`, against the schema,
+/// from a travel-itinerary generator) breaks the line as WPS shows it; the text ran together.
+#[test]
+fn a_break_inside_a_text_element_is_kept() {
+    let body = r#"<w:p><w:r><w:t xml:space="preserve">苏州-合肥<w:br/>早餐后<w:tab/>游览</w:t></w:r></w:p>"#;
+    let d = wordcraft_docx::read(&docx(body, &[], &[])).unwrap();
+    assert_eq!(paras(&d)[0].text, "苏州-合肥\n早餐后\t游览");
+}
