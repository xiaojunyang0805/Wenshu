+/// Whether a text element holds a line break or tab among its text (`<w:t>a<w:br/>b</w:t>`).
+fn has_inline_break(k: &El) -> bool {
+    k.kids.iter().any(|n| matches!(n, crate::xml::Node::El(e) if matches!(e.name.as_str(), "w:br" | "w:cr" | "w:tab")))
+}
