+/// Normal text in an equation keeps its East Asian font (`w:eastAsia`) through a save.
+#[test]
+fn equation_normal_text_east_asian_font_round_trips() {
+    use wordcraft_doc::math::{MNode, MRun, MSty, Math};
+    let nodes = vec![MNode::Run(MRun {
+        nor: true,
+        sty: Some(MSty::Plain),
+        font: Some("Times New Roman".into()),
+        font_ea: Some("KaiTi".into()),
+        ..MRun::new("年度")
+    })];
+    let mut d = Document::new();
+    let math = Math { nodes: nodes.clone(), ..Default::default() };
+    let mut p = Paragraph::with_text("", CharProps::default());
+    p.insert_object(0, InlineObject::Equation { linear: "\"年度\"".into(), display: true, math }, &CharProps::default()).unwrap();
+    d.body = vec![para_block(p)];
+    let r = rt(&d);
+    let got = paras(&r).iter().flat_map(|p| p.objects.iter()).find_map(|o| match o {
+        InlineObject::Equation { math, .. } => Some(math.nodes.clone()),
+        _ => None,
+    });
+    assert_eq!(got, Some(nodes));
+}
