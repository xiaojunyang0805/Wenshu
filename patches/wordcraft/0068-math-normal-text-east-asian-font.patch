+/// Normal text (`m:nor`) in a font without East Asian characters: they are drawn in the run's
+/// East Asian font, or a fallback face, not as missing-glyph boxes (one face for the whole run
+/// drew 年度 in Times New Roman as boxes).
+#[test]
+fn normal_text_characters_the_font_lacks_fall_back() {
+    crate::test_fonts();
+    let face = wordcraft_fonts::word::resolve("Times New Roman", false, false).face;
+    let Some(c) = ['中', '※', '⌘', '⇧'].into_iter().find(|c| !face.covers(*c) && FontDb::global().fallback_for(*c, face.id()).is_some())
+    else {
+        return; // Every candidate is in the font, or no fallback font is installed.
+    };
+    let want = format!("x{c}{c}y");
+    for font_ea in [None, Some("SimSun".to_string())] {
+        let run = MRun { nor: true, font: Some("Times New Roman".into()), font_ea: font_ea.clone(), ..MRun::new(want.clone()) };
+        let m = layout_equation(&Math { nodes: vec![MNode::Run(run)], ..Default::default() }, "", &rc(), true, 400.0, &MathProps::default(), &mut 0);
+        let mut text = String::new();
+        for it in &m.items {
+            if let MItem::Glyphs { glyphs, text: t, .. } = it {
+                assert!(glyphs.iter().all(|g| g.0 != 0), "{font_ea:?}: a missing glyph in {t:?}");
+                text.push_str(t);
+            }
+        }
+        assert_eq!(text, want, "{font_ea:?}");
+    }
+}
