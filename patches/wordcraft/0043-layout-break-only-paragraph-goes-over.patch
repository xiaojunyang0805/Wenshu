+/// A line holding only a page break that doesn't fit at the bottom of a page (WPS, at any line
+/// height): it stays there when its paragraph goes on after the break (a heading opening with
+/// one), and goes over when the paragraph is nothing but the break, leaving the next page blank.
+#[test]
+fn a_paragraph_of_only_a_page_break_goes_over_when_it_does_not_fit() {
+    let pages = |fillers: usize, heading: &str| {
+        let plain = ParaProps {
+            space_before: Some(0.0),
+            space_after: Some(0.0),
+            line_spacing: Some(wordcraft_doc::props::LineSpacing::Exactly(28.0)),
+            ..Default::default()
+        };
+        let para = |text: &str| {
+            let mut x = wordcraft_doc::Paragraph::with_text(text, Default::default());
+            x.props = plain.clone();
+            wordcraft_doc::para_block(x)
+        };
+        let mut d = Document::new();
+        d.body = (0..fillers).map(|i| para(&format!("F{i}"))).collect();
+        d.body.push(para(&format!("{}{heading}", wordcraft_doc::para::PAGE_BREAK)));
+        d.body.push(para("Text"));
+        lay(&d).pages.len()
+    };
+    // The filler count that leaves less than a line at the bottom of page 1.
+    let full = (10..80).find(|n| pages(*n + 1, "Annex") == 3).expect("a filler count that fills page 1");
+    assert_eq!(pages(full, "Annex"), 2, "the break opens a heading: its line stays");
+    assert_eq!(pages(full, ""), 3, "a paragraph of only the break goes over");
+    assert_eq!(pages(full - 1, ""), 2, "with room for it, it stays");
+}
