+/// The continuation of a split row with a minimum height shorter than the room its first part
+/// had keeps the whole minimum, not only the rest of it (WPS Office: a 34 pt row split after four
+/// of its five lines is 34.5 pt on the next page holding one line, probes in modes 11 to 15).
+#[test]
+fn a_split_rows_continuation_keeps_its_whole_minimum() {
+    crate::test_fonts();
+    use wordcraft_doc::props::{HeightRule, LineSpacing};
+    let exact = ParaProps { line_spacing: Some(LineSpacing::Exactly(14.0)), space_before: Some(0.0), space_after: Some(0.0), ..Default::default() };
+    // Letter, 1 inch margins: 648 pt of text. 43 filler lines of 14 pt leave 46 pt: three of the
+    // cell's four lines fit, the fourth moves on (mode 14: no widow control in the cell).
+    let text: Vec<String> = (0..43).map(|i| format!("Filler {i}")).collect();
+    let mut d = Document::from_text(&format!("{}\nAfter", text.join("\n")));
+    d.settings.compat_mode = 14;
+    for i in 0..=43 {
+        *para_props(&mut d, i) = exact.clone();
+    }
+    let mut t = Table::new(1, 1, 400.0);
+    t.props.cell_margins = Some([0.0, 5.4, 0.0, 5.4]);
+    t.rows[0].props.height = Some(34.0);
+    t.rows[0].props.height_rule = HeightRule::AtLeast;
+    let mut p = wordcraft_doc::Paragraph::with_text(&["B1", "B2", "B3", "B4"].join(&wordcraft_doc::para::LINE_BREAK.to_string()), Default::default());
+    p.props = exact.clone();
+    t.rows[0].cells[0].blocks = vec![wordcraft_doc::para_block(p)];
+    d.insert_block(StoryRef::Body, &Path::top(43), wordcraft_doc::Block::Table(t)).unwrap();
+    let l = lay(&d);
+    let parts: Vec<(usize, f32)> = l
+        .pages
+        .iter()
+        .enumerate()
+        .flat_map(|(i, pg)| pg.items.iter().map(move |it| (i, it)))
+        .filter_map(|(i, it)| if let Placed::Cell { rect, .. } = it { Some((i, rect.h)) } else { None })
+        .collect();
+    assert_eq!(parts.len(), 2, "the row splits: {parts:?}");
+    // 34 pt and the 0.5 pt top and bottom border bands, though one 14 pt line is left.
+    assert!((parts[1].1 - 35.0).abs() < 0.05, "{parts:?}");
+}
