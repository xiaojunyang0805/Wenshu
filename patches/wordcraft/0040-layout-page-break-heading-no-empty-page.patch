+/// A page break inside a paragraph ends what keep lines together and keep with next hold (WPS:
+/// a heading that opens with a page break, kept with the next paragraph and its lines together,
+/// lays out like one without the properties). It moved whole when the page was nearly full,
+/// then broke again: an empty page before each heading.
+#[test]
+fn a_page_break_inside_a_kept_paragraph_ends_what_is_kept() {
+    let page_of_heading = |fillers: usize, props: &ParaProps, marker: bool| -> (usize, usize) {
+        let plain = ParaProps {
+            space_before: Some(0.0),
+            space_after: Some(0.0),
+            line_spacing: Some(wordcraft_doc::props::LineSpacing::Exactly(28.0)),
+            ..Default::default()
+        };
+        let para = |text: &str, p: &ParaProps| {
+            let mut x = wordcraft_doc::Paragraph::with_text(text, Default::default());
+            x.props = p.clone();
+            wordcraft_doc::para_block(x)
+        };
+        let mut d = Document::new();
+        d.body = (0..fillers).map(|i| para(&format!("F{i}"), &plain)).collect();
+        let heading = ParaProps { line_spacing: plain.line_spacing, space_before: Some(0.0), space_after: Some(0.0), ..props.clone() };
+        let mut h = wordcraft_doc::Paragraph::with_text(&format!("{}Annex", wordcraft_doc::para::PAGE_BREAK), Default::default());
+        h.props = heading;
+        if marker {
+            // A bookmark ending between two paragraphs, which the reader carries onto the next.
+            h.insert_object(0, InlineObject::BookmarkEnd { name: "toc".into() }, &CharProps::default()).unwrap();
+        }
+        d.body.push(wordcraft_doc::para_block(h));
+        d.body.push(para("Text", &plain));
+        let l = lay(&d);
+        let annex = if marker { 1 + wordcraft_doc::para::OBJ.len_utf8() } else { 1 };
+        (l.caret(&Pos::body(fillers, annex)).unwrap().page, l.pages.len())
+    };
+    let none = ParaProps::default();
+    let kn = ParaProps { keep_next: Some(true), ..Default::default() };
+    let kl = ParaProps { keep_lines: Some(true), ..Default::default() };
+    let both = ParaProps { keep_next: Some(true), keep_lines: Some(true), ..Default::default() };
+    // The filler count after which the heading's text no longer starts on page 2.
+    let full = (10..80).find(|n| page_of_heading(*n, &none, false).0 == 2).expect("a filler count that fills page 1");
+    // Up to the bottom of page 1 (no room left even for the break's own line), the heading's
+    // text starts page 2: the keep properties change nothing, nor does a bookmark marker before
+    // the break (it shows nothing, so the break is still alone on its line).
+    for n in full - 4..full {
+        for marker in [false, true] {
+            assert_eq!(page_of_heading(n, &none, marker), (1, 2), "{n} fillers, marker {marker}");
+            for (props, label) in [(&kn, "keep with next"), (&kl, "keep lines"), (&both, "both")] {
+                assert_eq!(page_of_heading(n, props, marker), (1, 2), "{n} fillers, {label}, marker {marker}: no empty page");
+            }
+        }
+    }
+}
