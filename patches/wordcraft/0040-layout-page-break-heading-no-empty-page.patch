+/// The first line of `pl` that ends with a page or column break, unless it is the last line.
+fn break_line(pl: &ParaLayout) -> Option<usize> {
+    let last = pl.lines.len().checked_sub(1)?;
+    pl.lines.iter().take(last).position(|l| matches!(l.end, LineEnd::PageBreak | LineEnd::ColumnBreak))
+}
+
+/// The height of `pl`'s lines from the first to line `k` (all of them when `k` is past the end).
+fn lines_height(pl: &ParaLayout, k: usize) -> f32 {
+    match (pl.lines.first(), pl.lines.get(k).or(pl.lines.last())) {
+        (Some(first), Some(last)) => last.top + last.height - first.top,
+        _ => 0.0,
+    }
+}
