+#[test]
+fn added_font_dirs_are_cataloged_before_and_after_the_first_scan() {
+    let dir = font_dir("added");
+    // Before the first scan: the added folder is part of it, and its fonts load only when used.
+    let db = FontDb::with_font_dirs(Vec::new());
+    db.add_font_dirs([dir.clone(), dir.clone()]);
+    assert_eq!(db.styles(FAMILY), ["Regular", "Bold"]);
+    assert!(!db.is_loaded(FAMILY));
+    assert_eq!(db.load_system_fonts(), 2, "a folder added twice is read once");
+    // After it: adding a folder rescans, and a miss remembered before is found.
+    let db = FontDb::with_font_dirs(Vec::new());
+    assert!(!db.has_family(FAMILY));
+    assert_eq!(db.face(FAMILY, "Regular").family, FALLBACK_FAMILY);
+    db.add_font_dirs([dir]);
+    assert!(db.has_family(FAMILY));
+    assert_eq!(db.face(FAMILY, "Regular").family, FAMILY);
+}
