+    /// Add folders for the system font scan to read, such as fonts an app ships beside its
+    /// executable. Their fonts are cataloged like installed ones and load only when a document
+    /// uses them, so a large CJK family costs nothing until then. Folders already listed are
+    /// skipped. Once the folders have been scanned, adding one rescans them (native only; a no-op
+    /// on wasm).
+    pub fn add_font_dirs(&self, dirs: impl IntoIterator<Item = std::path::PathBuf>) {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let added = {
+                let mut list = self.font_dirs.write().unwrap_or_else(std::sync::PoisonError::into_inner);
+                let before = list.len();
+                for d in dirs {
+                    if !list.contains(&d) {
+                        list.push(d);
+                    }
+                }
+                list.len() > before
+            };
+            if added && self.cataloged.get().is_some() {
+                self.load_system_fonts();
+                // Misses remembered before the rescan may be found now.
+                self.fallbacks.write().unwrap_or_else(std::sync::PoisonError::into_inner).map.clear();
+                *self.run_fallbacks.write().unwrap_or_else(std::sync::PoisonError::into_inner) = RunFallbackCache::default();
+            }
+        }
+        #[cfg(target_arch = "wasm32")]
+        let _ = dirs;
+    }
