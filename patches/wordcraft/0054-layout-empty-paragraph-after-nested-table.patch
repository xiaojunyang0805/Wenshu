+/// An empty last paragraph right after a nested table takes no room: the cell ends at the nested
+/// table's bottom (WPS Office, probed 2026-11-04 with and without the line grid). With text, or
+/// with a second empty paragraph, the paragraphs count.
+#[test]
+fn an_empty_paragraph_after_a_nested_table_takes_no_room() {
+    let below = |tail: &[&str]| {
+        let mut d = Document::from_text("Above");
+        let mut t = Table::new(2, 1, 300.0);
+        let mut blocks = vec![wordcraft_doc::Block::Table(Table::new(2, 1, 200.0)).into()];
+        for text in tail {
+            blocks.push(wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, Default::default())));
+        }
+        t.rows[0].cells[0].blocks = blocks;
+        t.rows[1].cells[0].blocks = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text("R2", Default::default()))];
+        d.insert_block(StoryRef::Body, &Path::top(1), wordcraft_doc::Block::Table(t)).unwrap();
+        let l = lay(&d);
+        let at = |r: u32| l.caret(&Pos { story: StoryRef::Body, path: Path(vec![1, r, 0, 0]), off: 0 }).unwrap().top;
+        at(1)
+    };
+    let (none, empty, text, two) = (below(&[]), below(&[""]), below(&["Tx"]), below(&["", ""]));
+    assert!((empty - none).abs() < 0.05, "an empty last paragraph adds nothing: {empty} vs {none}");
+    assert!(text > empty + 5.0, "text adds a line: {text} vs {empty}");
+    assert!(two > text - 0.05, "two empty paragraphs both count: {two} vs {text}");
+}
