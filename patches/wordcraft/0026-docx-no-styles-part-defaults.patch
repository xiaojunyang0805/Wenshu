+#[test]
+fn a_file_without_a_styles_part_takes_the_application_defaults() {
+    // WPS Office lays such a file out single-spaced, with no space after paragraphs, in 10.5 pt
+    // Calibri and 宋体: not a new document's styles (1.15 spacing, 8 pt after).
+    let root = r#"<?xml version="1.0" encoding="UTF-8"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>"#;
+    let doc = r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p><w:r><w:t>x</w:t></w:r></w:p></w:body></w:document>"#;
+    let mut zw = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+    for (name, body) in [("_rels/.rels", root), ("word/document.xml", doc)] {
+        zw.start_file(name, zip::write::SimpleFileOptions::default()).unwrap();
+        zw.write_all(body.as_bytes()).unwrap();
+    }
+    let d = wordcraft_docx::read(&zw.finish().unwrap().into_inner()).unwrap();
+    let chr = d.styles.resolve_char(Some("Normal"), &CharProps::default());
+    assert_eq!(chr.size, 10.5);
+    let para = d.styles.resolve_para(&wordcraft_doc::ParaProps::default());
+    assert_eq!(para.line_spacing, wordcraft_doc::props::LineSpacing::Multiple(1.0));
+    assert_eq!(para.space_after, 0.0);
+}
