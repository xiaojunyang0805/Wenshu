+/// A run with a character border takes the border's width on each side (WPS, both modes: a 0.5 pt
+/// border moves the run 0.5 pt right and what follows 1 pt; `w:space` takes no room).
+#[test]
+fn a_bordered_run_takes_its_border_width_on_each_side() {
+    crate::test_fonts();
+    use wordcraft_doc::props::Border;
+    let xs = |border: Option<Border>| {
+        let mut d = Document::from_text("ab cd ef");
+        if let Some(b) = border {
+            d.format_range(&Pos::body(0, 3), &Pos::body(0, 5), &|c| c.border = Some(b)).unwrap();
+        }
+        let l = lay(&d);
+        let Some(Placed::Lines { para, .. }) = l.pages[0].items.iter().find(|i| matches!(i, Placed::Lines { .. })) else { panic!() };
+        let glyph = |k: usize| para.clusters.get(k).and_then(|c| para.glyphs.get(c.g0 as usize)).map_or(0.0, |g| g.dx) + para.x_of(0, k).unwrap();
+        (glyph(3), para.x_of(0, 6).unwrap())
+    };
+    let (plain, spaced) = (xs(None), xs(Some(Border { space: 4.0, ..Border::single(0.5) })));
+    assert!((spaced.0 - plain.0 - 0.5).abs() < 0.01, "the run's first letter at {}, {} without the border", spaced.0, plain.0);
+    assert!((spaced.1 - plain.1 - 1.0).abs() < 0.01, "what follows at {}, {} without the border", spaced.1, plain.1);
 }
 
