+/// A run of characters with a border (`w:bdr`) takes the border's width on each side: its first
+/// character moves right by it and its last is that much wider (WPS, both modes: 0.5, 1.5 and 3 pt
+/// borders widen 丙丁 and AB by twice that; `w:space` takes no room). Consecutive characters with
+/// the same border share one box, as they are drawn.
+pub(super) fn pad_borders(b: &mut Builder) {
+    let border = |b: &Builder, k: usize| {
+        let c = b.clusters.get(k)?;
+        if c.kind == ClKind::Marker && c.adv == 0.0 {
+            return None;
+        }
+        b.styles.get(c.style as usize).and_then(|s| s.rc.border).filter(wordcraft_doc::props::Border::is_visible)
+    };
+    let n = b.clusters.len();
+    let mut k = 0;
+    while k < n {
+        let Some(bd) = border(b, k) else {
+            k += 1;
+            continue;
+        };
+        let mut last = k;
+        while last + 1 < n && border(b, last + 1) == Some(bd) {
+            last += 1;
+        }
+        let w = border_room(Some(bd));
+        if let Some(c) = b.clusters.get_mut(k) {
+            c.adv += w;
+            let (g0, g1) = (c.g0 as usize, c.g1 as usize);
+            for g in b.glyphs.get_mut(g0..g1).into_iter().flatten() {
+                g.dx += w;
+            }
+        }
+        if let Some(c) = b.clusters.get_mut(last) {
+            c.adv += w;
+        }
+        k = last + 1;
+    }
+}
