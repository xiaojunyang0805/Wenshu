+/// A page or column break ending a line takes no height of its own either (WPS, both modes, with
+/// and without a line grid: 12 pt text before a 20 pt page or column break sits where it does
+/// before a 12 pt one).
+#[test]
+fn a_page_or_column_break_takes_no_height_of_its_own() {
+    crate::test_fonts();
+    for brk in [wordcraft_doc::para::PAGE_BREAK, wordcraft_doc::para::COLUMN_BREAK] {
+        let text = format!("Text{brk}Next");
+        let first = |break_size: f32| {
+            let mut d = Document::new();
+            d.body = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(&text, Default::default()))];
+            d.format_range(&Pos::body(0, 0), &Pos::body(0, text.len()), &|c| c.size = Some(12.0)).unwrap();
+            let at = text.find(brk).unwrap();
+            d.format_range(&Pos::body(0, at), &Pos::body(0, at + brk.len_utf8()), &|c| c.size = Some(break_size)).unwrap();
+            let l = lay(&d);
+            let para = l.pages[0].items.iter().find_map(|i| if let Placed::Lines { para, .. } = i { Some(para.clone()) } else { None }).unwrap();
+            para.lines.first().map(|l| l.height).unwrap()
+        };
+        let (small, large) = (first(12.0), first(20.0));
+        assert!((small - large).abs() < 0.01, "{brk:?}: a 20 pt break: {large}, a 12 pt one: {small}");
+    }
+}
