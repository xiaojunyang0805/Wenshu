+/// How far the line `c0..c1` lets its last cluster hang past the margin, and how much its
+/// automatic spaces give up for it ([`end_room`]): the mark's inked half kept inside when that
+/// fits, else hung whole.
+fn end_hang(pl: &ParaLayout, sc: &Scan, c1: usize, hang: f32) -> (f32, f32) {
+    let Some(h) = (c1 > sc.c0).then(|| pl.digit_hang(sc.c0, c1 - 1)).flatten() else { return (hang, 0.0) };
+    let over = content_end(pl, sc, c1) - sc.right_edge;
+    if over <= pl.squeeze_room(sc.c0, c1) + h.half + 0.01 { (0.0, h.half) } else { (hang, h.whole.unwrap_or(0.0)) }
+}
