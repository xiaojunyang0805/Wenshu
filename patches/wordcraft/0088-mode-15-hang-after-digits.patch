+/// Takes `amount` out of the automatic spaces of the line `c0..c1` (F55), each in proportion to
+/// its width: the clusters after each one move left.
+fn squeeze_gaps(pl: &ParaLayout, sc: &mut Scan, c1: usize, amount: f32) {
+    let c0 = sc.c0;
+    let total: f32 = pl.gaps(c0, c1).map(|(_, w)| w).sum();
+    if !(amount > 0.0 && total > 0.0) {
+        return;
+    }
+    let f = (amount / total).min(0.5);
+    let mut shift = 0.0;
+    let mut gaps = pl.gaps(c0, c1).peekable();
+    for k in c0..c1 {
+        if let Some(x) = sc.xs.get_mut(k - c0) {
+            *x -= shift;
+        }
+        while let Some((_, w)) = gaps.next_if(|(g, _)| *g == k) {
+            shift += f * w;
+        }
+    }
+}
