+/// How a justified mode-15 line may keep a closing mark that hangs past the margin when automatic
+/// spaces beside digits or Latin text come before it ([`ParaLayout::digit_hang`]): the room the
+/// automatic spaces may give up with the mark's inked half inside the margin, and with the mark
+/// hung whole (`None`: not at all).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct DigitHang {
+    pub(crate) half: f32,
+    pub(crate) whole: Option<f32>,
+}
+
+/// [`DigitHang`] for `a` automatic spaces on a line `n` em long, in ems (WPS, F55: 新細明體 11.5 and
+/// 12 pt, 15- to 35-character lines, 0–6 digit groups, 0.05 pt steps). Half in: half of each space,
+/// at most 0.905 / (1 + n / 102.6) / (1 + 0.08 a) em. Whole: only with one group (5/12 − n/120 em)
+/// or two (0.2125 − n/171 em), the spaces giving up half each at most.
+pub(crate) fn digit_hang_room(a: usize, gaps: f32, n: f32) -> DigitHang {
+    let a_f = a.min(1000) as f32;
+    let half = (gaps / 2.0).min(0.905 / (1.0 + n / 102.6) / (1.0 + 0.08 * a_f));
+    let whole = match a {
+        0 => Some(0.0),
+        1 | 2 => Some(5.0 / 12.0 - n / 120.0),
+        3 | 4 => Some(0.2125 - n / 171.4),
+        _ => None,
+    };
+    DigitHang { half, whole: whole.filter(|w| *w >= 0.0).map(|w| w.min(gaps / 2.0)) }
+}
