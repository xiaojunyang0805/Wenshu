+/// Mode 15, justified, a mark ending the line past the margin after digits (F55): what the automatic
+/// spaces give up with the mark's inked half inside, and with it hung whole, against WPS (12 pt,
+/// 0.05 pt steps): n characters, g digit groups (two automatic spaces of 0.25 em each), points.
+#[test]
+fn the_mode_15_hang_after_digits_follows_wps() {
+    // (n, g, half, whole: None when WPS never hangs whole)
+    let cases = [
+        (20.0, 1, 3.1, Some(3.1)),
+        (25.0, 1, 3.1, Some(2.5)),
+        (35.0, 1, 3.1, Some(1.5)),
+        (15.0, 2, 6.05, Some(1.55)),
+        (25.0, 2, 6.05, Some(0.8)),
+        (35.0, 2, 6.05, Some(0.15)),
+        (20.0, 3, 6.2, None),
+        (35.0, 3, 5.4, None),
+        (25.0, 4, 5.3, None),
+        (20.0, 6, 4.65, None),
+        (35.0, 6, 4.25, None),
+    ];
+    for (n, g, half, whole) in cases {
+        let h = crate::para::digit_hang_room(2 * g, g as f32 * 0.5, n);
+        assert!((h.half * 12.0 - half).abs() <= 0.25, "{n} chars, {g} groups: half in {} pt, WPS {half}", h.half * 12.0);
+        match (h.whole, whole) {
+            (Some(got), Some(wps)) => assert!((got * 12.0 - wps).abs() <= 0.25, "{n} chars, {g} groups: whole {} pt, WPS {wps}", got * 12.0),
+            (None, None) => {}
+            (got, wps) => panic!("{n} chars, {g} groups: whole {got:?}, WPS {wps:?}"),
+        }
+    }
+}
+
+/// Mode 15, justified, a closing mark that may hang ending the line after digits (F55): with four
+/// digit groups WPS doesn't hang it whole, and keeps it only if the automatic spaces can bring its
+/// inked half inside (not at 0.02 em past the character before it: that goes down with it); with
+/// one group it hangs it whole with the spaces squeezed (0.2 em short of the natural width).
+#[test]
+fn mode_15_hangs_a_mark_after_digits_as_wps() {
+    let lay15 = |text: &str, width: Option<f32>| {
+        let mut d = doc(text, CharSpacing::CompressPunctuation, width);
+        d.settings.compat_mode = 15;
+        if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+            p.props.align = Some(Align::Justify);
+            p.props.auto_space_dn = Some(true);
+            for r in &mut p.runs {
+                r.props.lang_ea = Some("zh-TW".into());
+            }
+        }
+        first_para(&lay(&d))
+    };
+    // Four groups take no whole hang whatever the mark's width; the squeezed whole hang of one
+    // group needs full-width marks.
+    let cases: &[(&str, f32, bool)] = if full_width_marks() {
+        &[("甲中1中中2中中3中中4中中中中中理。", 0.02, false), ("甲中中1中中中中中中中中中中中中理。", -0.2, true)]
+    } else {
+        &[("甲中1中中2中中3中中4中中中中中理。", 0.02, false)]
+    };
+    for &(text, past, kept) in cases {
+        let n = text.chars().count();
+        let g = lay15(text, None);
+        assert!(!g.auto_space.is_empty(), "automatic spaces beside the digits");
+        // The natural width up to the mark (the end of the character before it), in ems.
+        let natural = (g.lines[0].xs[n - 1] - g.lines[0].xs[0]) / SIZE;
+        let g = lay15(text, Some(natural + past));
+        let chars = g.lines[0].c1 - g.lines[0].c0;
+        assert_eq!(chars == n, kept, "{text} on a line {past} em past its natural width: {chars} of {n} characters kept");
+    }
+}
+
