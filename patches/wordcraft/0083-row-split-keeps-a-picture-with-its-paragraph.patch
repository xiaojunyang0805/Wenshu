+/// The paragraphs of a cell's `items` whose first line moves on at a row split (`splits`, as in
+/// [`split_row_with`]): the pictures anchored in them go with them (WPS: a caption's own floating
+/// picture that fits above the cut moves on with the caption).
+fn leaving_paragraphs<'a>(items: &'a [Placed], splits: &[usize]) -> Vec<&'a Path> {
+    items
+        .iter()
+        .zip(splits)
+        .filter_map(|(it, &split)| match it {
+            Placed::Lines { path, l0: 0, .. } if split == 0 => Some(path),
+            _ => None,
+        })
+        .collect()
+}
+
+/// Whether a picture or graphic is anchored in one of the paragraphs `leaving` the page.
+fn anchored_in(it: &Placed, leaving: &[&Path]) -> bool {
+    matches!(it, Placed::Image { path, .. } | Placed::Graphic { path, .. } if leaving.contains(&path))
+}
