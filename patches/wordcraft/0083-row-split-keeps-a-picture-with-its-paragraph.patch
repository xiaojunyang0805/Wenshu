+/// A row split doesn't leave a paragraph's floating picture behind without the paragraph: when a
+/// caption's first line moves on, its own top-and-bottom picture goes with it, though the picture
+/// alone would fit above the cut (WPS: the row moves to the next page whole).
+#[test]
+fn a_row_split_keeps_a_picture_with_its_paragraph() {
+    crate::test_fonts();
+    use wordcraft_doc::para::{Anchor, Float, Wrap};
+    let h = 200.0;
+    let mut d = Document::from_text("Filler");
+    let body = d.last_section.page_h - d.last_section.margin_top - d.last_section.margin_bottom;
+    if let Some(Block::Para(p)) = d.body.first_mut().map(Arc::make_mut) {
+        // Leaves the picture's height and 5 pt at the bottom of the page.
+        p.props.line_spacing = Some(wordcraft_doc::props::LineSpacing::Exactly(body - h - 5.0));
+        p.props.space_before = Some(0.0);
+        p.props.space_after = Some(0.0);
+    }
+    let mut t = Table::new(1, 1, 300.0);
+    t.props.cell_margins = Some([0.0, 5.4, 0.0, 5.4]);
+    let mut caption = wordcraft_doc::Paragraph::with_text("Caption", Default::default());
+    caption.props.space_before = Some(0.0);
+    caption.props.space_after = Some(0.0);
+    let float = Float { wrap: Wrap::TopAndBottom, h_rel: Anchor::Column, v_rel: Anchor::Paragraph, ..Default::default() };
+    let image = InlineObject::Image { media: "p".into(), w: 100.0, h, alt: String::new(), float, crop: [0.0; 4], ole: None, fx: Default::default() };
+    caption.insert_object(0, image, &Default::default()).unwrap();
+    t.rows[0].cells[0].blocks = vec![wordcraft_doc::para_block(caption)];
+    d.insert_block(StoryRef::Body, &Path::top(1), wordcraft_doc::Block::Table(t)).unwrap();
+    let l = lay(&d);
+    let page_of = |want: fn(&Placed) -> bool| l.pages.iter().position(|p| p.items.iter().any(want));
+    let picture = page_of(|i| matches!(i, Placed::Image { .. }));
+    let text = page_of(|i| matches!(i, Placed::Lines { path, .. } if path.0.len() > 1));
+    assert!(picture.is_some() && picture == text, "picture on page {picture:?}, its caption on {text:?}");
+}
