# Fetched and patched by scripts/sync-upstream.sh
/upstream/
# Evaluation clones, builds and results (see eval/EVALUATION_SUMMARY.md); the summary and findings are kept
/eval/kits/
/eval/target/
/target/
/out/
# Reference renders from proprietary suites: keep local unless their licence allows sharing
/corpus/ref/
/.cargo/config.toml
# Evaluation artefacts: only the written findings are published. Never commit fonts copied from
# an OS (eval/results/betteroffice/fonts holds proprietary Microsoft fonts).
/eval/results/**
!/eval/results/*/
!/eval/results/*/FINDINGS.md
/eval/corpus/
*.ttf
*.ttc
*.otf
